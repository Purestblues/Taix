<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- xunit v3 的测试工程本身是可执行程序 -->
        <OutputType>Exe</OutputType>
        <!-- 测试工程不参与 AOT / trim -->
        <PublishAot>false</PublishAot>
        <IsTrimmable>false</IsTrimmable>
        <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
        <EnableAotAnalyzer>false</EnableAotAnalyzer>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
        <!-- Avalonia.Headless.XUnit 12.x 依赖 xunit v3 -->
        <PackageReference Include="xunit.v3" Version="3.2.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
        <PackageReference Include="Avalonia.Headless" Version="12.1.1" />
        <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ShiJian.Client\ShiJian.Client.csproj" />
    </ItemGroup>

</Project>
