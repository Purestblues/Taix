<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="650"
             Foreground="{DynamicResource StandardTextBrush}"
             Background="Transparent"
             xmlns:vm="using:Taix.Client.ViewModels"
             x:DataType="vm:IndexPageViewModel"
             xmlns:Charts="using:Taix.Client.Controls.Charts"
             xmlns:models="using:Taix.Client.Controls.Charts.Model"
             xmlns:base="using:Taix.Client.Controls.Base"
             xmlns:select="using:Taix.Client.Controls.Select"
             xmlns:conv="using:Taix.Client.Controls.Converters"
             xmlns:platform="clr-namespace:Taix.Client.Platform"
             x:Class="Taix.Client.Views.IndexPage">

    <!--https://github.com/AvaloniaUI/Avalonia/issues/2441-->
    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem
                Header="{DynamicResource Refresh}" Command="{Binding RefreshCommand}" />
        </ContextMenu>
    </UserControl.ContextMenu>

    <UserControl.Resources>
        <conv:HextoColorConverter x:Key="HexToColor" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!--通用卡片-->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SettingPanelBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WindowBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.card:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource ChartCardHoverBorderBrush}" />
        </Style>

        <Style Selector="Border.statCard">
            <Setter Property="Background" Value="{DynamicResource SettingPanelBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WindowBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.statCard:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource ChartCardHoverBorderBrush}" />
            <Setter Property="RenderTransform" Value="translateY(-2px)" />
        </Style>

        <Style Selector="TextBlock.cardCaption">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
        </Style>

        <!--Avalonia 的类型选择器不匹配派生类，CountUpText 需要单独声明-->
        <Style Selector="base|CountUpText.statValue">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <!-- 滚动由 PageContainer 模板里的 ScrollViewer 提供，这里不要再套一层 -->
    <StackPanel x:Name="PageRoot" Margin="20,6,20,24">

            <!-- ═══ 头部：标题 + 周期切换 ═══ -->
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,14">
                <TextBlock Grid.Column="0" Text="{DynamicResource SideOverview}"
                           FontSize="18"
                           VerticalAlignment="Center" />

                <select:TabSwitch Grid.Column="2"
                                  IsShowIcon="False"
                                  SelectedItem="{Binding SelectedPeriod,Mode=TwoWay}"
                                  Options="{Binding PeriodOptions}" />
            </Grid>

            <!-- ═══ 总览卡片 ═══ -->
            <Grid x:Name="StatCardsPanel" ColumnDefinitions="*,10,*,10,*,10,*">

                <!-- 总使用时长 -->
                <Border Grid.Column="0" Classes="statCard">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <base:Icon IconType="Stopwatch" FontSize="12"
                                       Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Classes="cardCaption" Text="{DynamicResource CategoryTotalUsage}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <base:CountUpText Classes="statValue" Kind="Duration" Value="{Binding TotalTime}" Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,3,0,0">
                            <TextBlock Classes="cardCaption" Text="{Binding CompareCaption}"
                                       VerticalAlignment="Center" />
                            <base:DiffValue Value="{Binding TotalTime}" LastValue="{Binding LastTotalTime}"
                                            PositiveBrush="{DynamicResource ThemeBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 应用量 -->
                <Border Grid.Column="2" Classes="statCard">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <base:Icon IconType="Apps" FontSize="12"
                                       Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Classes="cardCaption" Text="{DynamicResource Usage}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <base:CountUpText Classes="statValue" Kind="Number" Value="{Binding AppCount}" Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,3,0,0">
                            <TextBlock Classes="cardCaption" Text="{Binding CompareCaption}"
                                       VerticalAlignment="Center" />
                            <base:DiffValue Type="Number" Value="{Binding AppCount}" LastValue="{Binding LastAppCount}"
                                            PositiveBrush="{DynamicResource ThemeBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 站点 -->
                <Border Grid.Column="4" Classes="statCard">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <base:Icon IconType="Website" FontSize="12"
                                       Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Classes="cardCaption" Text="{DynamicResource Site}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <base:CountUpText Classes="statValue" Kind="Number" Value="{Binding WebSiteCount}" Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,3,0,0">
                            <TextBlock Classes="cardCaption" Text="{Binding CompareCaption}"
                                       VerticalAlignment="Center" />
                            <base:DiffValue Type="Number" Value="{Binding WebSiteCount}" LastValue="{Binding LastWebSiteCount}"
                                            PositiveBrush="{DynamicResource ThemeBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 网页 -->
                <Border Grid.Column="6" Classes="statCard">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <base:Icon IconType="WebSearch" FontSize="12"
                                       Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Classes="cardCaption" Text="{DynamicResource Webpage}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <base:CountUpText Classes="statValue" Kind="Number" Value="{Binding WebPageCount}" Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,3,0,0">
                            <TextBlock Classes="cardCaption" Text="{Binding CompareCaption}"
                                       VerticalAlignment="Center" />
                            <base:DiffValue Type="Number" Value="{Binding WebPageCount}" LastValue="{Binding LastWebPageCount}"
                                            PositiveBrush="{DynamicResource ThemeBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══ 图表区：时段分布 + 分类占比 ═══ -->
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,16,0,0">
                <select:TabSwitch IsShowIcon="False"
                                  VerticalAlignment="Center"
                                  SelectedItem="{Binding ChartType,Mode=TwoWay}"
                                  Options="{Binding ChartTypeOptions}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Classes="cardCaption" Text="{DynamicResource Total}" VerticalAlignment="Center" />
                    <TextBlock Classes="cardCaption" Text="{Binding HourTotalText}"
                               Foreground="{DynamicResource DefaultTextBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="3*,12,2*" Margin="0,8,0,0" Height="196">

                <Border Grid.Column="0" Classes="card" Padding="16,12">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Text="{DynamicResource CategoryHourly}" FontSize="13" />

                        <Charts:StackedBarChart Grid.Row="1" Margin="0,10,0,0"
                                                Series="{Binding HourSeries}"
                                                Labels="{Binding HourLabels}"
                                                EmptyText="{DynamicResource NoData}"
                                                TextBrush="{DynamicResource SubTextBrush}"
                                                MutedTextBrush="{DynamicResource SubTextBrush}"
                                                AxisBrush="{DynamicResource WindowBorderBrush}"
                                                HoverBrush="{DynamicResource HoverBackgroundBrush}" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" Classes="card" Padding="16,12">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Text="{DynamicResource ClassificationProportion}" FontSize="13" />

                        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,6,0,0">
                            <Charts:DonutChart Width="128" Height="128"
                                               Thickness="13"
                                               Series="{Binding CategorySeries}"
                                               CenterText="{Binding CategoryTotalText}"
                                               CenterCaption="{Binding ChartDonutCaption}"
                                               EmptyText="{DynamicResource NoData}"
                                               TextBrush="{DynamicResource DefaultTextBrush}"
                                               MutedTextBrush="{DynamicResource SubTextBrush}"
                                               TrackBrush="{DynamicResource GrayDark}" />

                            <ScrollViewer Grid.Column="1" Margin="12,0,0,0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding CategorySeries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ChartsDataModel">
                                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,5">
                                                <Border Width="8" Height="8" CornerRadius="4"
                                                        VerticalAlignment="Center"
                                                        Background="{Binding Color, Converter={StaticResource HexToColor}}" />
                                                <TextBlock Grid.Column="1" Margin="6,0,0,0" FontSize="11"
                                                           Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource DefaultTextBrush}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" FontSize="11"
                                                           Text="{Binding Tag}"
                                                           Foreground="{DynamicResource SubTextBrush}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══ 最为频繁 ═══ -->
            <TextBlock Text="{DynamicResource MostFrequent}" Classes="sectionTitle" Margin="0,16,0,8" />

            <Grid ColumnDefinitions="3*,12,2*">
                <!--应用-->
                <Border Grid.Column="0" Classes="card" Padding="8">
                    <StackPanel>
                        <Border HorizontalAlignment="Left" Padding="9,4"
                                CornerRadius="{StaticResource RadiusSmall}"
                                Margin="4,2,0,4">
                            <Border.Background>
                                <SolidColorBrush Color="{DynamicResource HoverBackgroundColor}" Opacity=".5" />
                            </Border.Background>
                            <StackPanel Orientation="Horizontal" TextElement.Foreground="{DynamicResource SubTextBrush}">
                                <base:Icon VerticalAlignment="Center" IconType="Apps" FontSize="12" />
                                <TextBlock FontSize="10"
                                           VerticalAlignment="Center"
                                           Text="{DynamicResource App}"
                                           Margin="5,0,0,0" />
                            </StackPanel>
                        </Border>

                        <Charts:ListChart IconSize="{x:Static platform:PlatformConstants.SmallListIconSize}"
                                          Margin="0,2,0,0" IsCanScroll="False"
                                          BarBrush="{DynamicResource ThemeBrush}"
                                          Data="{Binding AppFrequentUseData}"
                                          ClickCommand="{Binding ToDetailCommand}"
                                          MenuType="App" />
                    </StackPanel>
                </Border>

                <!--网页-->
                <Border Grid.Column="2" Classes="card" Padding="8">
                    <StackPanel>
                        <Border HorizontalAlignment="Left" Padding="9,4"
                                CornerRadius="{StaticResource RadiusSmall}"
                                Margin="4,2,0,4">
                            <Border.Background>
                                <SolidColorBrush Color="{DynamicResource ThemeColor}" Opacity=".14" />
                            </Border.Background>
                            <StackPanel Orientation="Horizontal" TextElement.Foreground="{DynamicResource ThemeBrush}">
                                <base:Icon VerticalAlignment="Center" IconType="Website" FontSize="12" />
                                <TextBlock FontSize="10" VerticalAlignment="Center" Text="{DynamicResource Website}"
                                           Margin="5,0,0,0" />
                            </StackPanel>
                        </Border>

                        <Charts:ListChart IconSize="{x:Static platform:PlatformConstants.SmallListIconSize}"
                                          Margin="0,2,0,0" IsCanScroll="False"
                                          BarBrush="{DynamicResource ThemeBrush}"
                                          Data="{Binding WebFrequentUseData}"
                                          ClickCommand="{Binding ToDetailCommand}"
                                          MenuType="WebSite" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══ 更多 ═══ -->
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <TextBlock Text="{DynamicResource More}" Classes="sectionTitle" />
                <select:TabSwitch Margin="10,0,0,0"
                                  VerticalAlignment="Center" IsShowIcon="False"
                                  SelectedItem="{Binding MoreType,Mode=TwoWay}"
                                  Options="{Binding MoreTypeOptions}" />
            </StackPanel>

            <TabControl
                SelectedIndex="{Binding MoreType.Id}"
                BorderThickness="0"
                Margin="0,8,0,0"
                Padding="0"
                Background="Transparent">
                <TabControl.Styles>
                    <Style Selector="TabItem">
                        <Setter Property="Template">
                            <ControlTemplate />
                        </Setter>
                    </Style>
                </TabControl.Styles>
                <TabControl.ContextMenu>
                    <ContextMenu>
                        <MenuItem
                            Header="{DynamicResource Refresh}" Command="{Binding RefreshCommand}" />
                    </ContextMenu>
                </TabControl.ContextMenu>
                <TabItem>
                    <Charts:CardChart Data="{Binding AppMoreData}"
                                      MenuType="App"
                                      ShowLimit="{Binding MoreNum}"
                                      IconSize="{x:Static platform:PlatformConstants.CardChartIconSize}"
                                      ClickCommand="{Binding ToDetailCommand}" />
                </TabItem>
                <TabItem>
                    <Grid>
                        <Charts:CardChart Data="{Binding WebMoreData}" ClickCommand="{Binding ToDetailCommand}"
                                          ShowLimit="{Binding MoreNum}"
                                          IconSize="{x:Static platform:PlatformConstants.CardChartIconSize}"
                                          MenuType="WebSite" />
                    </Grid>
                </TabItem>
            </TabControl>

    </StackPanel>
</UserControl>
