<control:TPage xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="650"
xmlns:Charts="using:Taix.Client.Controls.Charts"
                xmlns:select="using:Taix.Client.Controls.Select"
                xmlns:base="using:Taix.Client.Controls.Base"
                xmlns:Button="using:Taix.Client.Controls.Button"
                xmlns:timeline="using:Taix.Client.Controls.Timeline"
                xmlns:control="using:Taix.Client.Controls"
                xmlns:converters="using:Taix.Client.Controls.Converters"
                xmlns:vm="using:Taix.Client.ViewModels"
               x:DataType="vm:DataPageViewModel"
               IsFillPage="True"
               x:Class="Taix.Client.Views.DataPage">
    <control:TPage.ContextMenu>
        <ContextMenu>
            <MenuItem Header="{DynamicResource Refresh}" Command="{Binding RefreshCommand}" />
        </ContextMenu>
    </control:TPage.ContextMenu>
    <control:TPage.Resources>
        <converters:BoolToThicknessConverter x:Key="PageMarginConverter"
                                             TrueValue="20,20,20,20"
                                             FalseValue="20,0,20,20" />
        <converters:BoolToThicknessConverter x:Key="ContentMarginConverter"
                                             TrueValue="0,13,0,0"
                                             FalseValue="0,0,0,0" />
        <converters:BoolToDoubleConverter x:Key="HeaderMaxHeightConverter"
                                          TrueValue="120"
                                          FalseValue="0" />
        <converters:BoolToDoubleConverter x:Key="BoolToOpacityConverter"
                                          TrueValue="1"
                                          FalseValue="0" />
        <converters:BoolToDoubleConverter x:Key="InverseOpacityConverter"
                                          TrueValue="0"
                                          FalseValue="1" />
        <converters:ShowTypeToContextMenuTypeConverter x:Key="ShowTypeToContextMenuTypeConverter" />
        <converters:HextoColorConverter x:Key="HextoColorConverter" />
    </control:TPage.Resources>
    <Grid>
    <Grid Margin="{Binding IsHeaderExpanded, Converter={StaticResource PageMarginConverter}}">
        <Grid.Transitions>
            <Transitions>
                <ThicknessTransition Property="Margin" Duration="0:0:0.22">
                    <ThicknessTransition.Easing>
                        <CubicEaseInOut />
                    </ThicknessTransition.Easing>
                </ThicknessTransition>
            </Transitions>
        </Grid.Transitions>
        <Grid.Styles>
            <Style Selector="select|TabSwitch#ColorModeSwitch select|TabOption">
                <Setter Property="Padding" Value="10,3" />
                <Setter Property="FontSize" Value="11" />
            </Style>
        </Grid.Styles>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ Row 0：标题 · 应用/网站切换 · 日期 · 周期 ═══ -->
        <Border MaxHeight="{Binding IsHeaderExpanded, Converter={StaticResource HeaderMaxHeightConverter}}"
                Opacity="{Binding IsHeaderExpanded, Converter={StaticResource BoolToOpacityConverter}}"
                IsHitTestVisible="{Binding IsHeaderExpanded}"
                ClipToBounds="True">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="MaxHeight" Duration="0:0:0.22">
                        <DoubleTransition.Easing>
                            <CubicEaseInOut />
                        </DoubleTransition.Easing>
                    </DoubleTransition>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.22">
                        <DoubleTransition.Easing>
                            <CubicEaseInOut />
                        </DoubleTransition.Easing>
                    </DoubleTransition>
                </Transitions>
            </Border.Transitions>
        <Grid ColumnDefinitions="Auto,*,Auto,Auto"
              Margin="0,5,0,20">
            <StackPanel Grid.Column="0" Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource SideDetails}"
                           FontSize="18"
                           VerticalAlignment="Center" />
                <select:TabSwitch Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               IsShowIcon="False"
                               SelectedItem="{Binding ShowType,Mode=TwoWay}"
                               Options="{Binding ShowTypeOptions}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10"
                        VerticalAlignment="Center">
                <!-- 日期选择 -->
                <Grid VerticalAlignment="Center">
                    <base:View Condition="0" Value="{Binding TabbarSelectedIndex}">
                        <select:DateSelect Date="{Binding DayDate,Mode=TwoWay}" />
                    </base:View>
                    <base:View Condition="1" Value="{Binding TabbarSelectedIndex}">
                        <select:DateSelect Date="{Binding WeekDate,Mode=TwoWay}"
                                           SelectType="Week" />
                    </base:View>
                    <base:View Condition="2" Value="{Binding TabbarSelectedIndex}">
                        <select:DateSelect Date="{Binding MonthDate,Mode=TwoWay}"
                                           SelectType="Month" />
                    </base:View>
                    <base:View Condition="3" Value="{Binding TabbarSelectedIndex}">
                        <select:DateSelect Date="{Binding YearDate,Mode=TwoWay}"
                                           SelectType="Year" />
                    </base:View>
                </Grid>

                <!-- 周期切换 -->
                <select:TabSwitch IsShowIcon="False"
                                  SelectedItem="{Binding SelectedPeriod,Mode=TwoWay}"
                                  Options="{Binding PeriodOptions}" />
            </StackPanel>

            <!-- 收起筛选栏 -->
            <StackPanel Grid.Column="3" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="10,0,0,0">
                <Button:IconButton Width="30" Height="30" FontSize="14"
                                   Icon="ChevronUpMed"
                                   ToolTip.Tip="{DynamicResource CollapseHeader}"
                                   Command="{Binding ToggleHeaderCommand}" />
            </StackPanel>
        </Grid>
        </Border>

        <TabControl
            Grid.Row="1"
            SelectedIndex="{Binding TabbarSelectedIndex}"
            BorderThickness="0"
            Margin="{Binding IsHeaderExpanded, Converter={StaticResource ContentMarginConverter}}"
            Padding="0"
            Background="Transparent">
            <TabControl.Transitions>
                <Transitions>
                    <ThicknessTransition Property="Margin" Duration="0:0:0.22">
                        <ThicknessTransition.Easing>
                            <CubicEaseInOut />
                        </ThicknessTransition.Easing>
                    </ThicknessTransition>
                </Transitions>
            </TabControl.Transitions>
            <TabControl.Styles>
                <Style Selector="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate />
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Styles>
            <TabItem>
                <Grid>
                    <!-- 应用模式：环形时钟 -->
                    <base:View Condition="0" Value="{Binding ShowType.Id}">
                        <Grid RowDefinitions="Auto,*">
                            <!-- 工具条：提示 + 配色模式 -->
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                <TextBlock FontSize="11"
                                           Text="{DynamicResource ClockHint}"
                                           Foreground="{DynamicResource SubTextBrush}"
                                           Opacity="0.6"
                                           VerticalAlignment="Center" />
                                <select:TabSwitch x:Name="ColorModeSwitch"
                                                  Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  IsShowIcon="False"
                                                  SelectedItem="{Binding SelectedColorMode, Mode=TwoWay}"
                                                  Options="{Binding ColorModeOptions}" />
                            </Grid>

                            <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                                <!-- 24 小时表盘 -->
                                <timeline:ClockRing HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    MaxWidth="470"
                                                    MaxHeight="470"
                                                    Thickness="32"
                                                    Margin="0,4,10,4"
                                                    Segments="{Binding DayClock.Segments}"
                                                    TickMode="{Binding DayClock.TickMode}"
                                                    RangeStart="{Binding DayClock.RangeStart}"
                                                    RangeEnd="{Binding DayClock.RangeEnd}"
                                                    UseCategoryColor="{Binding UseCategoryColor}"
                                                    CenterText="{Binding DayClock.CenterText}"
                                                    CenterCaption="{Binding DayClock.CenterCaption}"
                                                    EmptyText="{DynamicResource NoData}"
                                                    TextBrush="{DynamicResource StandardTextBrush}"
                                                    MutedTextBrush="{DynamicResource SubTextBrush}"
                                                    TrackBrush="{DynamicResource MultiTrackRowBorderBrush}"
                                                    ClickCommand="{Binding ToDetailCommand}" />

                                <!-- 前 5 名 + 其他 -->
                                <Border Grid.Column="1"
                                        Width="230"
                                        Margin="0,4,0,4"
                                        Padding="12,10"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource SettingPanelBgBrush}"
                                        BorderBrush="{DynamicResource SettingPanelBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusMedium}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{DynamicResource ClockLegendTitle}"
                                                   FontSize="11"
                                                   Margin="2,0,0,6"
                                                   Foreground="{DynamicResource SubTextBrush}" />
                                        <ItemsControl ItemsSource="{Binding DayClock.Legend}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="2,4"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            Command="{Binding $parent[UserControl].((vm:DataPageViewModel)DataContext).ClockLegendClickCommand}"
                                                            CommandParameter="{Binding}">
                                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                            <Ellipse Width="9" Height="9"
                                                                     VerticalAlignment="Center"
                                                                     Margin="0,0,8,0"
                                                                     Fill="{Binding Color, Converter={StaticResource HextoColorConverter}}" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Name}"
                                                                       FontSize="12"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource StandardTextBrush}" />
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding DurationText}"
                                                                       FontSize="12"
                                                                       Margin="8,0,0,0"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource StandardTextBrush}" />
                                                            <TextBlock Grid.Column="3"
                                                                       Text="{Binding ShareText}"
                                                                       FontSize="11"
                                                                       Width="36"
                                                                       TextAlignment="Right"
                                                                       Margin="8,0,0,0"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource SubTextBrush}" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </base:View>

                    <!-- 网站模式：列表图表 -->
                    <base:View Condition="1" Value="{Binding ShowType.Id}">
                        <Charts:ListChart IsShowBadge="True"
                                          IsSearch="True"
                                          MenuType="WebSite"
                                          Data="{Binding Data}"
                                          Margin="0,20,0,0"
                                          ClickCommand="{Binding ToDetailCommand}" />
                    </base:View>
                </Grid>
            </TabItem>
            <TabItem>
                <Grid ColumnDefinitions="*,420">
                    <timeline:ClockRing HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        MaxWidth="470"
                                        MaxHeight="470"
                                        Thickness="32"
                                        Margin="0,0,14,0"
                                        IsVisible="{Binding WeekClock.HasData}"
                                        Segments="{Binding WeekClock.Segments}"
                                        TickMode="{Binding WeekClock.TickMode}"
                                        RangeStart="{Binding WeekClock.RangeStart}"
                                        RangeEnd="{Binding WeekClock.RangeEnd}"
                                        UseCategoryColor="{Binding UseCategoryColor}"
                                        CenterText="{Binding WeekClock.CenterText}"
                                        CenterCaption="{Binding WeekClock.CenterCaption}"
                                        EmptyText="{DynamicResource NoData}"
                                        TextBrush="{DynamicResource StandardTextBrush}"
                                        MutedTextBrush="{DynamicResource SubTextBrush}"
                                        TrackBrush="{DynamicResource MultiTrackRowBorderBrush}"
                                        ClickCommand="{Binding ToDetailCommand}" />
                    <Charts:ListChart Grid.Column="1"
                               IsShowBadge="True"
                               IsSearch="True"
                               MenuType="{Binding ShowType.Id, Converter={StaticResource ShowTypeToContextMenuTypeConverter}}"
                               Data="{Binding WeekData}"
                               ClickCommand="{Binding ToDetailCommand}" />
                </Grid>
            </TabItem>
            <TabItem>
                <Grid ColumnDefinitions="*,420">
                    <timeline:ClockRing HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        MaxWidth="470"
                                        MaxHeight="470"
                                        Thickness="32"
                                        Margin="0,0,14,0"
                                        IsVisible="{Binding MonthClock.HasData}"
                                        Segments="{Binding MonthClock.Segments}"
                                        TickMode="{Binding MonthClock.TickMode}"
                                        RangeStart="{Binding MonthClock.RangeStart}"
                                        RangeEnd="{Binding MonthClock.RangeEnd}"
                                        UseCategoryColor="{Binding UseCategoryColor}"
                                        CenterText="{Binding MonthClock.CenterText}"
                                        CenterCaption="{Binding MonthClock.CenterCaption}"
                                        EmptyText="{DynamicResource NoData}"
                                        TextBrush="{DynamicResource StandardTextBrush}"
                                        MutedTextBrush="{DynamicResource SubTextBrush}"
                                        TrackBrush="{DynamicResource MultiTrackRowBorderBrush}"
                                        ClickCommand="{Binding ToDetailCommand}" />
                    <Charts:ListChart Grid.Column="1"
                               IsShowBadge="True"
                               IsSearch="True"
                               MenuType="{Binding ShowType.Id, Converter={StaticResource ShowTypeToContextMenuTypeConverter}}"
                               Data="{Binding MonthData}"
                               ClickCommand="{Binding ToDetailCommand}" />
                </Grid>
            </TabItem>
            <TabItem>
                <Grid ColumnDefinitions="*,420">
                    <timeline:ClockRing HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        MaxWidth="470"
                                        MaxHeight="470"
                                        Thickness="32"
                                        Margin="0,0,14,0"
                                        IsVisible="{Binding YearClock.HasData}"
                                        Segments="{Binding YearClock.Segments}"
                                        TickMode="{Binding YearClock.TickMode}"
                                        RangeStart="{Binding YearClock.RangeStart}"
                                        RangeEnd="{Binding YearClock.RangeEnd}"
                                        UseCategoryColor="{Binding UseCategoryColor}"
                                        CenterText="{Binding YearClock.CenterText}"
                                        CenterCaption="{Binding YearClock.CenterCaption}"
                                        EmptyText="{DynamicResource NoData}"
                                        TextBrush="{DynamicResource StandardTextBrush}"
                                        MutedTextBrush="{DynamicResource SubTextBrush}"
                                        TrackBrush="{DynamicResource MultiTrackRowBorderBrush}"
                                        ClickCommand="{Binding ToDetailCommand}" />
                    <Charts:ListChart Grid.Column="1"
                               IsShowBadge="True"
                               IsSearch="True"
                               MenuType="{Binding ShowType.Id, Converter={StaticResource ShowTypeToContextMenuTypeConverter}}"
                               Data="{Binding YearData}"
                               ClickCommand="{Binding ToDetailCommand}" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>

    <!-- 悬浮展开按钮：头部收起时悬浮在页面右上角留白处，不占用布局、不遮挡内容 -->
    <Border HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,4,4,0"
            Padding="1"
            CornerRadius="11"
            Background="{DynamicResource SettingPanelBgBrush}"
            BorderBrush="{DynamicResource SettingPanelBorderBrush}"
            BorderThickness="1"
            ZIndex="50"
            Opacity="{Binding IsHeaderExpanded, Converter={StaticResource InverseOpacityConverter}}"
            IsHitTestVisible="{Binding !IsHeaderExpanded}">
        <Border.Transitions>
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.22">
                    <DoubleTransition.Easing>
                        <CubicEaseInOut />
                    </DoubleTransition.Easing>
                </DoubleTransition>
            </Transitions>
        </Border.Transitions>
        <Button:IconButton Width="18" Height="18" FontSize="9"
                           Icon="ChevronDownMed"
                           ToolTip.Tip="{DynamicResource ExpandHeader}"
                           Command="{Binding ToggleHeaderCommand}" />
    </Border>
    </Grid>
</control:TPage>
