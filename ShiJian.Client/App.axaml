<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Name="时见"
             x:Class="ShiJian.Client.App">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Resources/Themes/Theme.axaml" />
                <ResourceInclude Source="/Resources/Themes/Common.axaml" />
                <ResourceInclude Source="/Themes/Generic.axaml" />
                <!--<ResourceInclude Source="/Resources/Localization/StringResources.en.axaml"/>-->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

        <ControlTheme x:Key="{x:Type WindowDrawnDecorations}"
                      TargetType="WindowDrawnDecorations">
            <Setter Property="DefaultTitleBarHeight" Value="0"/>
            <Setter Property="DefaultFrameThickness" Value="0"/>
            <Setter Property="DefaultShadowThickness" Value="0"/>

            <Setter Property="Template">
                <WindowDrawnDecorationsTemplate>
                    <WindowDrawnDecorationsContent />
                </WindowDrawnDecorationsTemplate>
            </Setter>
        </ControlTheme>
    </Application.Resources>

    <Application.Styles>
        <Style Selector="Window, ContextMenu, ToolTip, Menu">
            <Setter Property="FontFamily"
                    Value="Inter, Segoe UI Variable Text, Segoe UI, HarmonyOS Sans SC, MiSans, PingFang SC, Microsoft YaHei UI, sans-serif" />
        </Style>
        <SimpleTheme />
        <StyleInclude Source="/Themes/Base/FocusStyles.axaml" />
        <StyleInclude Source="/Themes/Base/UiKit.axaml" />
    </Application.Styles>

</Application>
