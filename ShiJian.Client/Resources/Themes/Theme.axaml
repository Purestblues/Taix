<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:servicers="using:ShiJian.Client.Servicers">

    <!-- 几何圆角标尺 (N14: 收敛圆角，消除浮夸玩具感) -->
    <CornerRadius x:Key="RadiusXs">4</CornerRadius>
    <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">12</CornerRadius>
    <CornerRadius x:Key="RadiusXLarge">12</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <!-- 字号标尺 -->
    <x:Double x:Key="FontSizeXs">11</x:Double>
    <x:Double x:Key="FontSizeSm">12</x:Double>
    <x:Double x:Key="FontSizeMd">14</x:Double>
    <x:Double x:Key="FontSizeLg">16</x:Double>
    <x:Double x:Key="FontSizeXl">18</x:Double>
    <x:Double x:Key="FontSizeXxl">22</x:Double>
    <x:Double x:Key="FontSizeSection">12</x:Double>

    <ResourceDictionary.ThemeDictionaries>
        <!-- 暗色主题 (Nord Polar Night) -->
        <ResourceDictionary x:Key="Default">
            <!-- 品牌与语义颜色 -->
            <Color x:Key="ThemeColor">#78A0F0</Color>
            <SolidColorBrush x:Key="ThemeBrush" Color="{StaticResource ThemeColor}" />
            <SolidColorBrush x:Key="ThemeTintBrush" Color="#2678A0F0" />

            <Color x:Key="SuccessColor">#A3BE8C</Color>
            <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
            <SolidColorBrush x:Key="SuccessTintBrush" Color="#24A3BE8C" />

            <Color x:Key="WarningColor">#EBCB8B</Color>
            <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
            <SolidColorBrush x:Key="WarningTintBrush" Color="#24EBCB8B" />

            <Color x:Key="DangerColor">#D6747D</Color>
            <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
            <SolidColorBrush x:Key="DangerTintBrush" Color="#24D6747D" />

            <SolidColorBrush x:Key="OnBrandBrush" Color="#0F141C" />
            <SolidColorBrush x:Key="OnAccentBrush" Color="#0F141C" />

            <Color x:Key="Accent2Color">#B48EAD</Color>
            <SolidColorBrush x:Key="Accent2Brush" Color="{StaticResource Accent2Color}" />
            <SolidColorBrush x:Key="ChartCompareBrush" Color="{StaticResource Accent2Color}" Opacity="0.18" />
            <SolidColorBrush x:Key="SelectRingBrush" Color="#2678A0F0" />

            <SolidColorBrush x:Key="WebBadgeBgBrush" Color="#2678A0F0" />
            <SolidColorBrush x:Key="WebBadgeFgBrush" Color="#8DB1F6" />
            <SolidColorBrush x:Key="ThemeBadgeBgBrush" Color="{DynamicResource ThemeColor}" Opacity="0.20" />
            <SolidColorBrush x:Key="ThemeBadgeFgBrush" Color="{DynamicResource ThemeColor}" />

            <!-- 五级表面系统 Surface0 -> Surface4 -->
            <Color x:Key="Surface0">#181A20</Color>
            <Color x:Key="Surface0Color">#181A20</Color>
            <SolidColorBrush x:Key="Surface0Brush" Color="{StaticResource Surface0}" />

            <Color x:Key="Surface1">#13151A</Color>
            <Color x:Key="Surface1Color">#13151A</Color>
            <SolidColorBrush x:Key="Surface1Brush" Color="{StaticResource Surface1}" />

            <Color x:Key="Surface2">#21252E</Color>
            <Color x:Key="Surface2Color">#21252E</Color>
            <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2}" />

            <Color x:Key="Surface3">#282D38</Color>
            <Color x:Key="Surface3Color">#282D38</Color>
            <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3}" />

            <Color x:Key="Surface4">#2E3440</Color>
            <Color x:Key="Surface4Color">#2E3440</Color>
            <SolidColorBrush x:Key="Surface4Brush" Color="{StaticResource Surface4}" />

            <!-- 边框与分割线 -->
            <Color x:Key="BorderSubtle">#2A303C</Color>
            <Color x:Key="BorderDefault">#3B4252</Color>
            <Color x:Key="BorderStrong">#3B4252</Color>

            <SolidColorBrush x:Key="DividerSubtleBrush" Color="{StaticResource BorderSubtle}" />
            <SolidColorBrush x:Key="DividerStrongBrush" Color="{StaticResource BorderStrong}" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource BorderSubtle}" />
            <SolidColorBrush x:Key="CardBorderHoverBrush" Color="{StaticResource BorderStrong}" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="{StaticResource BorderStrong}" />
            <SolidColorBrush x:Key="WindowBorderBrush" Color="{StaticResource BorderDefault}" />
            <SolidColorBrush x:Key="WindowContentBorder" Color="{StaticResource BorderSubtle}" />
            <SolidColorBrush x:Key="CardBorder" Color="{StaticResource BorderSubtle}" />
            <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource BorderSubtle}" />
            <Color x:Key="SeparatorColor">#2A303C</Color>
            <SolidColorBrush x:Key="SeparatorBrush" Color="{StaticResource BorderSubtle}" />

            <!-- 墨色排印令牌 -->
            <Color x:Key="TextPrimary">#ECEFF4</Color>
            <Color x:Key="TextSecondary">#A5B0C2</Color>
            <Color x:Key="TextTertiary">#8C97AB</Color>
            <Color x:Key="TextDisabled">#687285</Color>

            <Color x:Key="DefaultTextColor">#ECEFF4</Color>
            <SolidColorBrush x:Key="DefaultTextBrush" Color="{StaticResource TextPrimary}" />
            <SolidColorBrush x:Key="StandardTextBrush" Color="{StaticResource TextPrimary}" />
            <SolidColorBrush x:Key="SubTextBrush" Color="{StaticResource TextSecondary}" />
            <Color x:Key="WhiteBgTextColor">#A5B0C2</Color>
            <SolidColorBrush x:Key="WhiteBgTextBrush" Color="{StaticResource WhiteBgTextColor}" />
            <Color x:Key="DisabledTextColor">#687285</Color>
            <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource TextDisabled}" />
            <Color x:Key="TitleBarBtnColor">#ECEFF4</Color>
            <SolidColorBrush x:Key="TitleBarBtnBrush" Color="{StaticResource TitleBarBtnColor}" />

            <!-- 状态与交互层 -->
            <Color x:Key="HoverBackgroundColor">#12ECEFF4</Color>
            <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{StaticResource HoverBackgroundColor}" />
            <SolidColorBrush x:Key="RowHoverBrush" Color="{StaticResource HoverBackgroundColor}" />
            <SolidColorBrush x:Key="PressedBackgroundBrush" Color="#1FECEFF4" />
            <SolidColorBrush x:Key="SelectionPillBrush" Color="#2A3856" />
            <SolidColorBrush x:Key="RowSelectedBrush" Color="#2A3856" />
            <SolidColorBrush x:Key="ScrimBrush" Color="#80090A0F" />

            <!-- 彻底清除光晕 -->
            <SolidColorBrush x:Key="ContentGlowTopBrush" Color="#00000000" />
            <SolidColorBrush x:Key="ContentGlowBottomBrush" Color="#00000000" />

            <!-- 深色海拔（不透明度翻倍） -->
            <BoxShadows x:Key="ElevationCard">0 1 2 0 #14000000</BoxShadows>
            <BoxShadows x:Key="Elevation1">0 2 6 0 #1A000000, 0 1 2 0 #10000000</BoxShadows>
            <BoxShadows x:Key="Elevation2">0 6 16 -2 #2C000000, 0 2 6 -1 #18000000</BoxShadows>
            <BoxShadows x:Key="Elevation3">0 16 36 -4 #4D000000, 0 4 12 -2 #28000000</BoxShadows>

            <x:Double x:Key="TitleBarIconStroke">1.25</x:Double>

            <!-- 窗口与核心容器底色 -->
            <SolidColorBrush x:Key="Background" Color="{StaticResource Surface0}" />
            <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource Surface0}" />
            <SolidColorBrush x:Key="WindowBackgroundSolid" Color="{StaticResource Surface0}" />
            <SolidColorBrush x:Key="WindowBackgroundModern" Color="{StaticResource Surface0}" />
            <SolidColorBrush x:Key="WindowBackgroundClassic" Color="{StaticResource Surface0}" />
            <SolidColorBrush x:Key="WindowBackgroundOriginal" Color="{StaticResource Surface0}" />
            <SolidColorBrush x:Key="WindowContentBackground" Color="{StaticResource Surface0}" />
            <SolidColorBrush x:Key="StandardBackgroundBrush" Color="{StaticResource Surface3}" />
            <SolidColorBrush x:Key="StandardBackgroundBrush2" Color="{StaticResource Surface2}" />
            <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource Surface2}" />

            <!-- 弹出层与菜单 -->
            <Color x:Key="PopupBackgroundColor">#2E3440</Color>
            <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{StaticResource Surface4}" />
            <Color x:Key="PopupBorderColor">#3E4656</Color>
            <SolidColorBrush x:Key="PopupBorderBrush" Color="{StaticResource PopupBorderColor}" />
            <Color x:Key="ContextBorderColor">#3E4656</Color>
            <SolidColorBrush x:Key="ContextBorderBrush" Color="{StaticResource ContextBorderColor}" />
            <SolidColorBrush x:Key="ContextMenuItemHoverBrush" Color="#12ECEFF4" />
            <SolidColorBrush x:Key="ContextMenuItemHoverBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ContextMenuItemPressedBrush" Color="#1FECEFF4" />
            <SolidColorBrush x:Key="ContextMenuItemPressedBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ContextMenuSubmenuBgBrush" Color="{StaticResource Surface4}" />
            <SolidColorBrush x:Key="ContextMenuSubmenuBorderBrush" Color="{StaticResource PopupBorderColor}" />

            <!-- 搜索面板 -->
            <Color x:Key="SearchSurfaceColor">#2E3440</Color>
            <Color x:Key="SearchInputColor">#282D38</Color>
            <Color x:Key="SearchFooterColor">#21252E</Color>
            <Color x:Key="SearchBorderLightColor">#3E4656</Color>
            <Color x:Key="SearchBorderMediumColor">#4C566A</Color>
            <SolidColorBrush x:Key="SearchSurfaceBrush" Color="{StaticResource SearchSurfaceColor}" />
            <SolidColorBrush x:Key="SearchInputBrush" Color="{StaticResource SearchInputColor}" />
            <SolidColorBrush x:Key="SearchFooterBrush" Color="{StaticResource SearchFooterColor}" />
            <SolidColorBrush x:Key="SearchBorderLightBrush" Color="{StaticResource SearchBorderLightColor}" />

            <!-- 侧边栏兼容映射 -->
            <Color x:Key="NavSelectedColor">#2A3856</Color>
            <SolidColorBrush x:Key="NavSelectedBrush" Color="{StaticResource NavSelectedColor}" />
            <Color x:Key="NavUnselectedTextColor">#A5B0C2</Color>
            <SolidColorBrush x:Key="NavUnselectedTextBrush" Color="{StaticResource NavUnselectedTextColor}" />
            <SolidColorBrush x:Key="NavGlassBackgroundBrush" Color="{StaticResource Surface1}" />
            <SolidColorBrush x:Key="NavGlassBorderBrush" Color="{StaticResource BorderSubtle}" />
            <SolidColorBrush x:Key="NavBorderBrush" Color="{StaticResource BorderSubtle}" />
            <SolidColorBrush x:Key="NavSelectedGlassBrush" Color="#2A3856" />
            <SolidColorBrush x:Key="NavSelectedGlassBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="NavHoverGlassBrush" Color="#12ECEFF4" />

            <!-- 设置面板 -->
            <Color x:Key="SettingPanelBgColor">#21252E</Color>
            <SolidColorBrush x:Key="SettingPanelBgBrush" Color="{StaticResource Surface2}" />
            <SolidColorBrush x:Key="SettingPanelBorderBrush" Color="{StaticResource BorderSubtle}" />
            <SolidColorBrush x:Key="SettingPanelHoverBrush" Color="#12ECEFF4" />
            <SolidColorBrush x:Key="SettingPanelAccentBorderBrush" Color="{DynamicResource ThemeColor}" Opacity="0.45" />
            <SolidColorBrush x:Key="SettingGroupTitleBrush" Color="{StaticResource TextSecondary}" />
            <Color x:Key="SettingPanelSpliteLineColor">#2A303C</Color>
            <SolidColorBrush x:Key="SettingPanelSpliteLineBrush" Color="{StaticResource SettingPanelSpliteLineColor}" />

            <!-- 日期选择器 -->
            <SolidColorBrush x:Key="DatePickerGlassBackgroundBrush" Color="{StaticResource Surface2}" />
            <SolidColorBrush x:Key="DatePickerGlassBorderBrush" Color="{StaticResource BorderSubtle}" />
            <SolidColorBrush x:Key="DatePickerHoverGlassBrush" Color="#12ECEFF4" />
            <Color x:Key="DatePickerItemBgColor">#282D38</Color>
            <SolidColorBrush x:Key="DatePickerItemBgBrush" Color="{StaticResource DatePickerItemBgColor}" />

            <!-- 列表项 -->
            <Color x:Key="ListItemIconBgColor">#282D38</Color>
            <SolidColorBrush x:Key="ListItemIconBgBrush" Color="{StaticResource ListItemIconBgColor}" />
            <Color x:Key="BaseListItemBgColor">#282D38</Color>
            <SolidColorBrush x:Key="BaseListItemBgBrush" Color="{StaticResource BaseListItemBgColor}" />
            <Color x:Key="BaseListItemHoverBgColor">#2E3440</Color>
            <SolidColorBrush x:Key="ListItemHoverBrush" Color="#12ECEFF4" />
            <SolidColorBrush x:Key="ListItemPressedBrush" Color="#1FECEFF4" />
            <SolidColorBrush x:Key="ListItemSelectedBrush" Color="#2A3856" />
            <SolidColorBrush x:Key="ListItemSelectedHoverBrush" Color="#324367" />
            <SolidColorBrush x:Key="ListItemAccentBrush" Color="{DynamicResource ThemeColor}" Opacity="0.85" />
            <SolidColorBrush x:Key="ListItemCardHoverBgBrush" Color="#282D38" />
            <SolidColorBrush x:Key="ListItemCardHoverBorderBrush" Color="#3B4252" />

            <!-- 图表与卡片 -->
            <Color x:Key="ChartMonthGridItemBgColor">#282D38</Color>
            <SolidColorBrush x:Key="ChartMonthGridItemBgBrush" Color="{StaticResource ChartMonthGridItemBgColor}" />
            <Color x:Key="ChartColBorderColor">#2A303C</Color>
            <SolidColorBrush x:Key="ChartColBorderBrush" Color="{StaticResource ChartColBorderColor}" />
            <Color x:Key="ChartTypeListProgressBarColor">#282D38</Color>
            <SolidColorBrush x:Key="ChartTypeListProgressBarBrush" Color="{StaticResource ChartTypeListProgressBarColor}" />
            <Color x:Key="CategoryAppNumBgColor">#282D38</Color>
            <SolidColorBrush x:Key="CategoryAppNumBgBrush" Color="{StaticResource CategoryAppNumBgColor}" />

            <SolidColorBrush x:Key="CategoryCardGlassBgBrush" Color="{StaticResource Surface2}" />
            <SolidColorBrush x:Key="CategoryCardGlassBorderBrush" Color="{StaticResource BorderSubtle}" />
            <SolidColorBrush x:Key="CategoryCardHoverGlassBrush" Color="{StaticResource Surface3}" />
            <SolidColorBrush x:Key="CategoryCardHoverBorderBrush" Color="{StaticResource BorderStrong}" />

            <SolidColorBrush x:Key="ChartCardGlassBgBrush" Color="{StaticResource Surface2}" />
            <SolidColorBrush x:Key="ChartCardGlassBorderBrush" Color="{StaticResource BorderSubtle}" />
            <SolidColorBrush x:Key="ChartCardHoverGlassBgBrush" Color="{StaticResource Surface3}" />
            <SolidColorBrush x:Key="ChartCardHoverBorderBrush" Color="{StaticResource BorderStrong}" />
            <SolidColorBrush x:Key="ChartCardPillBgBrush" Color="{DynamicResource ThemeColor}" Opacity="0.20" />
            <SolidColorBrush x:Key="ChartCardPillTextBrush" Color="{StaticResource TextPrimary}" />

            <!-- 输入框与折叠容器 -->
            <Color x:Key="InputBoxBgColor">#282D38</Color>
            <SolidColorBrush x:Key="InputBoxBgBrush" Color="{StaticResource InputBoxBgColor}" />
            <Color x:Key="InputBoxHoverColor">#2E3440</Color>
            <SolidColorBrush x:Key="InputBoxHoverBrush" Color="{StaticResource InputBoxHoverColor}" />
            <Color x:Key="InputBoxFocusedBgColor">#282D38</Color>
            <SolidColorBrush x:Key="InputBoxFocusedBgBrush" Color="{StaticResource InputBoxFocusedBgColor}" />

            <Color x:Key="ExpanderBgColor">#21252E</Color>
            <SolidColorBrush x:Key="ExpanderBgBrush" Color="{StaticResource ExpanderBgColor}" />
            <Color x:Key="ExpanderContentBgColor">#282D38</Color>
            <SolidColorBrush x:Key="ExpanderContentBgBrush" Color="{StaticResource ExpanderContentBgColor}" />

            <!-- 骨架屏与滚动条 -->
            <Color x:Key="PlaceholderRectBgColor">#282D38</Color>
            <SolidColorBrush x:Key="PlaceholderRectBgBrush" Color="{StaticResource PlaceholderRectBgColor}" />
            <Color x:Key="PlaceholderRectBgFlashColor">#3B4252</Color>
            <SolidColorBrush x:Key="PlaceholderRectBgFlashBrush" Color="{StaticResource PlaceholderRectBgFlashColor}" />
            <Color x:Key="ScrollBarColor">#687285</Color>
            <SolidColorBrush x:Key="ScrollBarBrush" Color="{StaticResource ScrollBarColor}" />
            <SolidColorBrush x:Key="GrayDark" Color="#21252E" Opacity="0.7" />

            <!-- 分段切换与多选项 -->
            <SolidColorBrush x:Key="TabSwitchBgBrush" Color="{StaticResource Surface3}" />
            <SolidColorBrush x:Key="TabSwitchBorderBrush" Color="{StaticResource BorderSubtle}" />
            <Color x:Key="TabOptionTextColor">#A5B0C2</Color>
            <Color x:Key="TabOptionTextCheckedColor">#78A0F0</Color>
            <SolidColorBrush x:Key="TabOptionSelectedBrush" Color="{StaticResource Surface2}" />
            <SolidColorBrush x:Key="TabSliderBorderBrush" Color="{StaticResource BorderSubtle}" />
            <SolidColorBrush x:Key="TabOptionSelectedBorderBrush" Color="{StaticResource BorderSubtle}" />

            <SolidColorBrush x:Key="OptionUncheckedBorderBrush" Color="{StaticResource BorderStrong}" />
            <SolidColorBrush x:Key="OptionCheckedBorderBrush" Color="#78A0F0" />
            <SolidColorBrush x:Key="OptionCheckedBackgroundBrush" Color="#2A3856" />
            <SolidColorBrush x:Key="OptionHoverBrush" Color="#12ECEFF4" />

            <!-- Timeline 时间轴 -->
            <SolidColorBrush x:Key="TimelineBgBrush" Color="#181A20" />
            <SolidColorBrush x:Key="TimelineBorderBrush" Color="#2A303C" />
            <SolidColorBrush x:Key="TimelineHeaderBgBrush" Color="#E613151A" />
            <SolidColorBrush x:Key="TimelineInactiveBrush" Color="#3B4252" />
            <SolidColorBrush x:Key="TimelineTickMajorBrush" Color="#4C566A" />
            <SolidColorBrush x:Key="TimelineTickHalfBrush" Color="#3B4252" />
            <SolidColorBrush x:Key="TimelineTickQuarterBrush" Color="#2A303C" />
            <SolidColorBrush x:Key="TimelineTickTextBrush" Color="#A5B0C2" />
            <SolidColorBrush x:Key="TimelineTimeLabelBrush" Color="#D9A5B0C2" />
            <SolidColorBrush x:Key="TimelineNowBrush" Color="#78A0F0" />
            <SolidColorBrush x:Key="TimelineSelectBgBrush" Color="#3378A0F0" />
            <SolidColorBrush x:Key="TimelineSelectBorderBrush" Color="#CC78A0F0" />
            <SolidColorBrush x:Key="TimelineTipBgBrush" Color="#2E3440" />
            <SolidColorBrush x:Key="TimelineTipBorderBrush" Color="#3E4656" />
            <SolidColorBrush x:Key="TimelineTipTextBrush" Color="#ECEFF4" />
            <SolidColorBrush x:Key="TimelineTipSubBrush" Color="#A5B0C2" />
            <SolidColorBrush x:Key="TimelineTrackBgBrush" Color="#21252E" />
            <SolidColorBrush x:Key="TimelineTooltipShadowBrush" Color="#4D000000" />
            <Color x:Key="TimelineIdleColor">#4C566A</Color>
            <Color x:Key="TimelineDefaultColor">#7E8B9B</Color>
            <SolidColorBrush x:Key="TimelineNowDotOuterBrush" Color="#ECEFF4" />

            <SolidColorBrush x:Key="TimelinePeriodNightBgBrush" Color="#1E2432" />
            <SolidColorBrush x:Key="TimelinePeriodMorningBgBrush" Color="#1E2C26" />
            <SolidColorBrush x:Key="TimelinePeriodNoonBgBrush" Color="#252A34" />
            <SolidColorBrush x:Key="TimelinePeriodAfternoonBgBrush" Color="#2D2620" />
            <SolidColorBrush x:Key="TimelinePeriodEveningBgBrush" Color="#282332" />

            <SolidColorBrush x:Key="TimelineSelectionMaskBrush" Color="#33090A0F" />
            <SolidColorBrush x:Key="TimelineSelectionBorderBrush" Color="#78A0F0" />
            <SolidColorBrush x:Key="TimelineSelectionGlowBrush" Color="#1F78A0F0" />
            <SolidColorBrush x:Key="TimelineSelectionHandleBrush" Color="#78A0F0" />
            <SolidColorBrush x:Key="TimelineSelectionHandleBorderBrush" Color="#ECEFF4" />
            <SolidColorBrush x:Key="TimelineSelectionLabelBgBrush" Color="#21252E" />
            <SolidColorBrush x:Key="TimelineSelectionLabelTextBrush" Color="#ECEFF4" />

            <!-- 多轨时间轴 -->
            <SolidColorBrush x:Key="MultiTrackRowBgBrush" Color="#21252E" />
            <SolidColorBrush x:Key="MultiTrackRowBorderBrush" Color="#2A303C" />
            <SolidColorBrush x:Key="MultiTrackRowHoverBgBrush" Color="#282D38" />
            <SolidColorBrush x:Key="MultiTrackIconBgBrush" Color="#282D38" />
            <SolidColorBrush x:Key="MultiTrackTrackBgBrush" Color="#181A20" />
            <SolidColorBrush x:Key="MultiTrackTrackBorderBrush" Color="#2A303C" />

            <!-- ColorModeToggle -->
            <SolidColorBrush x:Key="ColorModeToggleBgBrush" Color="#1D2129" />
            <SolidColorBrush x:Key="ColorModeToggleBorderBrush" Color="#2A303C" />
            <SolidColorBrush x:Key="ColorModeToggleCheckedBgBrush" Color="#2E3440" />
            <SolidColorBrush x:Key="ColorModeToggleCheckedBorderBrush" Color="#4C566A" />
            <SolidColorBrush x:Key="ColorModeToggleCheckedTextBrush" Color="#ECEFF4" />
            <SolidColorBrush x:Key="ColorModeToggleUncheckedTextBrush" Color="#687285" />
            <SolidColorBrush x:Key="ColorModeToggleHoverTextBrush" Color="#A5B0C2" />
        </ResourceDictionary>

        <!-- 浅色主题 (Nord Snow Storm) -->
        <ResourceDictionary x:Key="Light">
            <!-- 品牌与语义颜色 -->
            <Color x:Key="ThemeColor">#527CE6</Color>
            <SolidColorBrush x:Key="ThemeBrush" Color="{StaticResource ThemeColor}" />
            <SolidColorBrush x:Key="ThemeTintBrush" Color="#24527CE6" />

            <Color x:Key="SuccessColor">#5C9A64</Color>
            <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
            <SolidColorBrush x:Key="SuccessTintBrush" Color="#225C9A64" />

            <Color x:Key="WarningColor">#C98A3E</Color>
            <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
            <SolidColorBrush x:Key="WarningTintBrush" Color="#22C98A3E" />

            <Color x:Key="DangerColor">#BF616A</Color>
            <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
            <SolidColorBrush x:Key="DangerTintBrush" Color="#22BF616A" />

            <SolidColorBrush x:Key="OnBrandBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />

            <Color x:Key="Accent2Color">#9D7298</Color>
            <SolidColorBrush x:Key="Accent2Brush" Color="{StaticResource Accent2Color}" />
            <SolidColorBrush x:Key="ChartCompareBrush" Color="{StaticResource Accent2Color}" Opacity="0.18" />
            <SolidColorBrush x:Key="SelectRingBrush" Color="#26527CE6" />

            <SolidColorBrush x:Key="WebBadgeBgBrush" Color="#24527CE6" />
            <SolidColorBrush x:Key="WebBadgeFgBrush" Color="#3E67CE" />
            <SolidColorBrush x:Key="ThemeBadgeBgBrush" Color="{DynamicResource ThemeColor}" Opacity="0.14" />
            <SolidColorBrush x:Key="ThemeBadgeFgBrush" Color="{DynamicResource ThemeColor}" />

            <!-- 五级表面系统 Surface0 -> Surface4 -->
            <Color x:Key="Surface0">#ECEFF4</Color>
            <Color x:Key="Surface0Color">#ECEFF4</Color>
            <SolidColorBrush x:Key="Surface0Brush" Color="{StaticResource Surface0}" />

            <Color x:Key="Surface1">#E5E9F0</Color>
            <Color x:Key="Surface1Color">#E5E9F0</Color>
            <SolidColorBrush x:Key="Surface1Brush" Color="{StaticResource Surface1}" />

            <Color x:Key="Surface2">#FFFFFF</Color>
            <Color x:Key="Surface2Color">#FFFFFF</Color>
            <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2}" />

            <Color x:Key="Surface3">#F2F4F8</Color>
            <Color x:Key="Surface3Color">#F2F4F8</Color>
            <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3}" />

            <Color x:Key="Surface4">#FFFFFF</Color>
            <Color x:Key="Surface4Color">#FFFFFF</Color>
            <SolidColorBrush x:Key="Surface4Brush" Color="{StaticResource Surface4}" />

            <!-- 边框与分割线 -->
            <Color x:Key="BorderSubtle">#D8DEE9</Color>
            <Color x:Key="BorderDefault">#C2CAD8</Color>
            <Color x:Key="BorderStrong">#C2CAD8</Color>

            <SolidColorBrush x:Key="DividerSubtleBrush" Color="{StaticResource BorderSubtle}" />
            <SolidColorBrush x:Key="DividerStrongBrush" Color="{StaticResource BorderStrong}" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource BorderSubtle}" />
            <SolidColorBrush x:Key="CardBorderHoverBrush" Color="{StaticResource BorderStrong}" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="{StaticResource BorderStrong}" />
            <SolidColorBrush x:Key="WindowBorderBrush" Color="{StaticResource BorderDefault}" />
            <SolidColorBrush x:Key="WindowContentBorder" Color="{StaticResource BorderSubtle}" />
            <SolidColorBrush x:Key="CardBorder" Color="{StaticResource BorderSubtle}" />
            <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource BorderSubtle}" />
            <Color x:Key="SeparatorColor">#D8DEE9</Color>
            <SolidColorBrush x:Key="SeparatorBrush" Color="{StaticResource BorderSubtle}" />

            <!-- 墨色排印令牌 -->
            <Color x:Key="TextPrimary">#2E3440</Color>
            <Color x:Key="TextSecondary">#646E82</Color>
            <Color x:Key="TextTertiary">#646E82</Color>
            <Color x:Key="TextDisabled">#9AA3B5</Color>

            <Color x:Key="DefaultTextColor">#2E3440</Color>
            <SolidColorBrush x:Key="DefaultTextBrush" Color="{StaticResource TextPrimary}" />
            <SolidColorBrush x:Key="StandardTextBrush" Color="{StaticResource TextPrimary}" />
            <SolidColorBrush x:Key="SubTextBrush" Color="{StaticResource TextSecondary}" />
            <Color x:Key="WhiteBgTextColor">#646E82</Color>
            <SolidColorBrush x:Key="WhiteBgTextBrush" Color="{StaticResource WhiteBgTextColor}" />
            <Color x:Key="DisabledTextColor">#9AA3B5</Color>
            <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource TextDisabled}" />
            <Color x:Key="TitleBarBtnColor">#2E3440</Color>
            <SolidColorBrush x:Key="TitleBarBtnBrush" Color="{StaticResource TitleBarBtnColor}" />

            <!-- 状态与交互层 -->
            <Color x:Key="HoverBackgroundColor">#0C2E3440</Color>
            <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{StaticResource HoverBackgroundColor}" />
            <SolidColorBrush x:Key="RowHoverBrush" Color="{StaticResource HoverBackgroundColor}" />
            <SolidColorBrush x:Key="PressedBackgroundBrush" Color="#172E3440" />
            <SolidColorBrush x:Key="SelectionPillBrush" Color="#D2DEF5" />
            <SolidColorBrush x:Key="RowSelectedBrush" Color="#D2DEF5" />
            <SolidColorBrush x:Key="ScrimBrush" Color="#6612151E" />

            <!-- 彻底清除紫色渐变光晕 -->
            <SolidColorBrush x:Key="ContentGlowTopBrush" Color="#00000000" />
            <SolidColorBrush x:Key="ContentGlowBottomBrush" Color="#00000000" />

            <!-- 克制浅色海拔 -->
            <BoxShadows x:Key="ElevationCard">0 1 2 0 #06000000</BoxShadows>
            <BoxShadows x:Key="Elevation1">0 2 6 0 #0D000000, 0 1 2 0 #08000000</BoxShadows>
            <BoxShadows x:Key="Elevation2">0 6 16 -2 #16000000, 0 2 6 -1 #0C000000</BoxShadows>
            <BoxShadows x:Key="Elevation3">0 16 36 -4 #26000000, 0 4 12 -2 #14000000</BoxShadows>

            <x:Double x:Key="TitleBarIconStroke">1.2</x:Double>

            <!-- 窗口与核心容器底色 -->
            <SolidColorBrush x:Key="Background" Color="{StaticResource Surface0}" />
            <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource Surface0}" />
            <SolidColorBrush x:Key="WindowBackgroundSolid" Color="{StaticResource Surface0}" />
            <SolidColorBrush x:Key="WindowBackgroundModern" Color="{StaticResource Surface0}" />
            <SolidColorBrush x:Key="WindowBackgroundClassic" Color="{StaticResource Surface0}" />
            <SolidColorBrush x:Key="WindowBackgroundOriginal" Color="{StaticResource Surface0}" />
            <SolidColorBrush x:Key="WindowContentBackground" Color="{StaticResource Surface0}" />
            <SolidColorBrush x:Key="StandardBackgroundBrush" Color="{StaticResource Surface3}" />
            <SolidColorBrush x:Key="StandardBackgroundBrush2" Color="{StaticResource Surface2}" />
            <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource Surface2}" />

            <!-- 弹出层与菜单 -->
            <Color x:Key="PopupBackgroundColor">#FFFFFF</Color>
            <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{StaticResource Surface4}" />
            <Color x:Key="PopupBorderColor">#CFD6E4</Color>
            <SolidColorBrush x:Key="PopupBorderBrush" Color="{StaticResource PopupBorderColor}" />
            <Color x:Key="ContextBorderColor">#CFD6E4</Color>
            <SolidColorBrush x:Key="ContextBorderBrush" Color="{StaticResource ContextBorderColor}" />
            <SolidColorBrush x:Key="ContextMenuItemHoverBrush" Color="#0C2E3440" />
            <SolidColorBrush x:Key="ContextMenuItemHoverBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ContextMenuItemPressedBrush" Color="#172E3440" />
            <SolidColorBrush x:Key="ContextMenuItemPressedBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ContextMenuSubmenuBgBrush" Color="{StaticResource Surface4}" />
            <SolidColorBrush x:Key="ContextMenuSubmenuBorderBrush" Color="{StaticResource PopupBorderColor}" />

            <!-- 搜索面板 -->
            <Color x:Key="SearchSurfaceColor">#FFFFFF</Color>
            <Color x:Key="SearchInputColor">#F2F4F8</Color>
            <Color x:Key="SearchFooterColor">#ECEFF4</Color>
            <Color x:Key="SearchBorderLightColor">#D8DEE9</Color>
            <Color x:Key="SearchBorderMediumColor">#C2CAD8</Color>
            <SolidColorBrush x:Key="SearchSurfaceBrush" Color="{StaticResource SearchSurfaceColor}" />
            <SolidColorBrush x:Key="SearchInputBrush" Color="{StaticResource SearchInputColor}" />
            <SolidColorBrush x:Key="SearchFooterBrush" Color="{StaticResource SearchFooterColor}" />
            <SolidColorBrush x:Key="SearchBorderLightBrush" Color="{StaticResource SearchBorderLightColor}" />

            <!-- 侧边栏兼容映射 -->
            <Color x:Key="NavSelectedColor">#D2DEF5</Color>
            <SolidColorBrush x:Key="NavSelectedBrush" Color="{StaticResource NavSelectedColor}" />
            <Color x:Key="NavUnselectedTextColor">#646E82</Color>
            <SolidColorBrush x:Key="NavUnselectedTextBrush" Color="{StaticResource NavUnselectedTextColor}" />
            <SolidColorBrush x:Key="NavGlassBackgroundBrush" Color="{StaticResource Surface1}" />
            <SolidColorBrush x:Key="NavGlassBorderBrush" Color="{StaticResource BorderSubtle}" />
            <SolidColorBrush x:Key="NavBorderBrush" Color="{StaticResource BorderSubtle}" />
            <SolidColorBrush x:Key="NavSelectedGlassBrush" Color="#D2DEF5" />
            <SolidColorBrush x:Key="NavSelectedGlassBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="NavHoverGlassBrush" Color="#0C2E3440" />

            <!-- 设置面板 -->
            <Color x:Key="SettingPanelBgColor">#FFFFFF</Color>
            <SolidColorBrush x:Key="SettingPanelBgBrush" Color="{StaticResource Surface2}" />
            <SolidColorBrush x:Key="SettingPanelBorderBrush" Color="{StaticResource BorderSubtle}" />
            <SolidColorBrush x:Key="SettingPanelHoverBrush" Color="#0C2E3440" />
            <SolidColorBrush x:Key="SettingPanelAccentBorderBrush" Color="{DynamicResource ThemeColor}" Opacity="0.35" />
            <SolidColorBrush x:Key="SettingGroupTitleBrush" Color="{StaticResource TextSecondary}" />
            <Color x:Key="SettingPanelSpliteLineColor">#D8DEE9</Color>
            <SolidColorBrush x:Key="SettingPanelSpliteLineBrush" Color="{StaticResource SettingPanelSpliteLineColor}" />

            <!-- 日期选择器 -->
            <SolidColorBrush x:Key="DatePickerGlassBackgroundBrush" Color="{StaticResource Surface2}" />
            <SolidColorBrush x:Key="DatePickerGlassBorderBrush" Color="{StaticResource BorderSubtle}" />
            <SolidColorBrush x:Key="DatePickerHoverGlassBrush" Color="#0C2E3440" />
            <Color x:Key="DatePickerItemBgColor">#F2F4F8</Color>
            <SolidColorBrush x:Key="DatePickerItemBgBrush" Color="{StaticResource DatePickerItemBgColor}" />

            <!-- 列表项 -->
            <Color x:Key="ListItemIconBgColor">#F2F4F8</Color>
            <SolidColorBrush x:Key="ListItemIconBgBrush" Color="{StaticResource ListItemIconBgColor}" />
            <Color x:Key="BaseListItemBgColor">#F2F4F8</Color>
            <SolidColorBrush x:Key="BaseListItemBgBrush" Color="{StaticResource BaseListItemBgColor}" />
            <Color x:Key="BaseListItemHoverBgColor">#E5E9F0</Color>
            <SolidColorBrush x:Key="ListItemHoverBrush" Color="#0C2E3440" />
            <SolidColorBrush x:Key="ListItemPressedBrush" Color="#172E3440" />
            <SolidColorBrush x:Key="ListItemSelectedBrush" Color="#D2DEF5" />
            <SolidColorBrush x:Key="ListItemSelectedHoverBrush" Color="#C5D5F2" />
            <SolidColorBrush x:Key="ListItemAccentBrush" Color="{DynamicResource ThemeColor}" Opacity="0.90" />
            <SolidColorBrush x:Key="ListItemCardHoverBgBrush" Color="#F2F4F8" />
            <SolidColorBrush x:Key="ListItemCardHoverBorderBrush" Color="#C2CAD8" />

            <!-- 图表与卡片 -->
            <Color x:Key="ChartMonthGridItemBgColor">#F2F4F8</Color>
            <SolidColorBrush x:Key="ChartMonthGridItemBgBrush" Color="{StaticResource ChartMonthGridItemBgColor}" />
            <Color x:Key="ChartColBorderColor">#D8DEE9</Color>
            <SolidColorBrush x:Key="ChartColBorderBrush" Color="{StaticResource ChartColBorderColor}" />
            <Color x:Key="ChartTypeListProgressBarColor">#E5E9F0</Color>
            <SolidColorBrush x:Key="ChartTypeListProgressBarBrush" Color="{StaticResource ChartTypeListProgressBarColor}" />
            <Color x:Key="CategoryAppNumBgColor">#F2F4F8</Color>
            <SolidColorBrush x:Key="CategoryAppNumBgBrush" Color="{StaticResource CategoryAppNumBgColor}" />

            <SolidColorBrush x:Key="CategoryCardGlassBgBrush" Color="{StaticResource Surface2}" />
            <SolidColorBrush x:Key="CategoryCardGlassBorderBrush" Color="{StaticResource BorderSubtle}" />
            <SolidColorBrush x:Key="CategoryCardHoverGlassBrush" Color="{StaticResource Surface3}" />
            <SolidColorBrush x:Key="CategoryCardHoverBorderBrush" Color="{StaticResource BorderStrong}" />

            <SolidColorBrush x:Key="ChartCardGlassBgBrush" Color="{StaticResource Surface2}" />
            <SolidColorBrush x:Key="ChartCardGlassBorderBrush" Color="{StaticResource BorderSubtle}" />
            <SolidColorBrush x:Key="ChartCardHoverGlassBgBrush" Color="{StaticResource Surface3}" />
            <SolidColorBrush x:Key="ChartCardHoverBorderBrush" Color="{StaticResource BorderStrong}" />
            <SolidColorBrush x:Key="ChartCardPillBgBrush" Color="{DynamicResource ThemeColor}" Opacity="0.14" />
            <SolidColorBrush x:Key="ChartCardPillTextBrush" Color="{DynamicResource ThemeColor}" />

            <!-- 输入框与折叠容器 -->
            <Color x:Key="InputBoxBgColor">#FFFFFF</Color>
            <SolidColorBrush x:Key="InputBoxBgBrush" Color="{StaticResource InputBoxBgColor}" />
            <Color x:Key="InputBoxHoverColor">#FFFFFF</Color>
            <SolidColorBrush x:Key="InputBoxHoverBrush" Color="{StaticResource InputBoxHoverColor}" />
            <Color x:Key="InputBoxFocusedBgColor">#FFFFFF</Color>
            <SolidColorBrush x:Key="InputBoxFocusedBgBrush" Color="{StaticResource InputBoxFocusedBgColor}" />

            <Color x:Key="ExpanderBgColor">#FFFFFF</Color>
            <SolidColorBrush x:Key="ExpanderBgBrush" Color="{StaticResource ExpanderBgColor}" />
            <Color x:Key="ExpanderContentBgColor">#F2F4F8</Color>
            <SolidColorBrush x:Key="ExpanderContentBgBrush" Color="{StaticResource ExpanderContentBgColor}" />

            <!-- 骨架屏与滚动条 -->
            <Color x:Key="PlaceholderRectBgColor">#E5E9F0</Color>
            <SolidColorBrush x:Key="PlaceholderRectBgBrush" Color="{StaticResource PlaceholderRectBgColor}" />
            <Color x:Key="PlaceholderRectBgFlashColor">#F2F4F8</Color>
            <SolidColorBrush x:Key="PlaceholderRectBgFlashBrush" Color="{StaticResource PlaceholderRectBgFlashColor}" />
            <Color x:Key="ScrollBarColor">#9AA3B5</Color>
            <SolidColorBrush x:Key="ScrollBarBrush" Color="{StaticResource ScrollBarColor}" />
            <SolidColorBrush x:Key="GrayDark" Color="#E5E9F0" Opacity="0.7" />

            <!-- 分段切换与多选项 -->
            <SolidColorBrush x:Key="TabSwitchBgBrush" Color="{StaticResource Surface3}" />
            <SolidColorBrush x:Key="TabSwitchBorderBrush" Color="{StaticResource BorderSubtle}" />
            <Color x:Key="TabOptionTextColor">#646E82</Color>
            <Color x:Key="TabOptionTextCheckedColor">#527CE6</Color>
            <SolidColorBrush x:Key="TabOptionSelectedBrush" Color="{StaticResource Surface2}" />
            <SolidColorBrush x:Key="TabSliderBorderBrush" Color="{StaticResource BorderSubtle}" />
            <SolidColorBrush x:Key="TabOptionSelectedBorderBrush" Color="{StaticResource BorderSubtle}" />

            <SolidColorBrush x:Key="OptionUncheckedBorderBrush" Color="{StaticResource BorderStrong}" />
            <SolidColorBrush x:Key="OptionCheckedBorderBrush" Color="#527CE6" />
            <SolidColorBrush x:Key="OptionCheckedBackgroundBrush" Color="#D2DEF5" />
            <SolidColorBrush x:Key="OptionHoverBrush" Color="#0C2E3440" />

            <!-- Timeline 时间轴 -->
            <SolidColorBrush x:Key="TimelineBgBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TimelineBorderBrush" Color="#D8DEE9" />
            <SolidColorBrush x:Key="TimelineHeaderBgBrush" Color="#E6E5E9F0" />
            <SolidColorBrush x:Key="TimelineInactiveBrush" Color="#D8DEE9" />
            <SolidColorBrush x:Key="TimelineTickMajorBrush" Color="#C2CAD8" />
            <SolidColorBrush x:Key="TimelineTickHalfBrush" Color="#D8DEE9" />
            <SolidColorBrush x:Key="TimelineTickQuarterBrush" Color="#E5E9F0" />
            <SolidColorBrush x:Key="TimelineTickTextBrush" Color="#646E82" />
            <SolidColorBrush x:Key="TimelineTimeLabelBrush" Color="#D9646E82" />
            <SolidColorBrush x:Key="TimelineNowBrush" Color="#527CE6" />
            <SolidColorBrush x:Key="TimelineSelectBgBrush" Color="#29527CE6" />
            <SolidColorBrush x:Key="TimelineSelectBorderBrush" Color="#CC527CE6" />
            <SolidColorBrush x:Key="TimelineTipBgBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TimelineTipBorderBrush" Color="#CFD6E4" />
            <SolidColorBrush x:Key="TimelineTipTextBrush" Color="#2E3440" />
            <SolidColorBrush x:Key="TimelineTipSubBrush" Color="#646E82" />
            <SolidColorBrush x:Key="TimelineTrackBgBrush" Color="#F2F4F8" />
            <SolidColorBrush x:Key="TimelineTooltipShadowBrush" Color="#1F000000" />
            <Color x:Key="TimelineIdleColor">#9AA3B5</Color>
            <Color x:Key="TimelineDefaultColor">#7E8B9B</Color>
            <SolidColorBrush x:Key="TimelineNowDotOuterBrush" Color="#CFD6E4" />

            <SolidColorBrush x:Key="TimelinePeriodNightBgBrush" Color="#DFE6F2" />
            <SolidColorBrush x:Key="TimelinePeriodMorningBgBrush" Color="#DCEBDF" />
            <SolidColorBrush x:Key="TimelinePeriodNoonBgBrush" Color="#E5E9F0" />
            <SolidColorBrush x:Key="TimelinePeriodAfternoonBgBrush" Color="#EFE5DA" />
            <SolidColorBrush x:Key="TimelinePeriodEveningBgBrush" Color="#E5E0EE" />

            <SolidColorBrush x:Key="TimelineSelectionMaskBrush" Color="#2412151E" />
            <SolidColorBrush x:Key="TimelineSelectionBorderBrush" Color="#527CE6" />
            <SolidColorBrush x:Key="TimelineSelectionGlowBrush" Color="#1A527CE6" />
            <SolidColorBrush x:Key="TimelineSelectionHandleBrush" Color="#527CE6" />
            <SolidColorBrush x:Key="TimelineSelectionHandleBorderBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TimelineSelectionLabelBgBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TimelineSelectionLabelTextBrush" Color="#2E3440" />

            <!-- 多轨时间轴 -->
            <SolidColorBrush x:Key="MultiTrackRowBgBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="MultiTrackRowBorderBrush" Color="#D8DEE9" />
            <SolidColorBrush x:Key="MultiTrackRowHoverBgBrush" Color="#F2F4F8" />
            <SolidColorBrush x:Key="MultiTrackIconBgBrush" Color="#F2F4F8" />
            <SolidColorBrush x:Key="MultiTrackTrackBgBrush" Color="#ECEFF4" />
            <SolidColorBrush x:Key="MultiTrackTrackBorderBrush" Color="#D8DEE9" />

            <!-- ColorModeToggle -->
            <SolidColorBrush x:Key="ColorModeToggleBgBrush" Color="#E5E9F0" />
            <SolidColorBrush x:Key="ColorModeToggleBorderBrush" Color="#D8DEE9" />
            <SolidColorBrush x:Key="ColorModeToggleCheckedBgBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ColorModeToggleCheckedBorderBrush" Color="#C2CAD8" />
            <SolidColorBrush x:Key="ColorModeToggleCheckedTextBrush" Color="#2E3440" />
            <SolidColorBrush x:Key="ColorModeToggleUncheckedTextBrush" Color="#646E82" />
            <SolidColorBrush x:Key="ColorModeToggleHoverTextBrush" Color="#2E3440" />
        </ResourceDictionary>

        <!-- 蔚蓝模式（Nord Frost Ice）：基于同一套 Surface 架构 -->
        <ResourceDictionary x:Key="{x:Static servicers:ThemeServicer.Azure}">
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Resources/Themes/Azure.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
