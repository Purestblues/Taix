<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:ShiJian.Client.Controls.Toggle">


    <ControlTheme x:Key="{x:Type controls:Toggle}" TargetType="controls:Toggle">
        <Setter Property="Height" Value="20" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />

        <Styles>
            <Style Selector="controls|Toggle[IsChecked=True]">
                <Style Selector="^ /template/ TextBlock#OnText">
                    <Setter Property="IsVisible" Value="True" />
                </Style>

                <Style Selector="^ /template/ TextBlock#OffText">
                    <Setter Property="IsVisible" Value="False" />
                </Style>

                <Style Selector="^ /template/ Border#Mark">
                    <Setter Property="RenderTransform" Value="translateX(18px)" />
                    <Setter Property="Background" Value="White" />
                </Style>

                <Style Selector="^ /template/ Path#CheckMark">
                    <Setter Property="IsVisible" Value="True" />
                </Style>

                <Style Selector="^ /template/ Border#Button">
                    <Setter Property="Background" Value="{DynamicResource ThemeBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush}" />
                </Style>
            </Style>

            <Style Selector="controls|Toggle[IsChecked=False]">
                <Style Selector="^ /template/ TextBlock#OnText">
                    <Setter Property="IsVisible" Value="False" />
                </Style>

                <Style Selector="^ /template/ TextBlock#OffText">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
            </Style>

            <Style Selector="controls|Toggle:pointerover[IsChecked=False] /template/ Border#Button">
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderHoverBrush}" />
            </Style>

            <Style Selector="controls|Toggle[TextPosition=Left]">
                <Style Selector="^ /template/ Grid#TextContainer">
                    <Setter Property="Grid.Column" Value="0" />
                    <Setter Property="Margin" Value="0,0,8,0" />
                </Style>
            </Style>
        </Styles>
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="Border" Background="{TemplateBinding Background}"
                        Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"
                        CornerRadius="4" Margin="{TemplateBinding Margin}">

                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="Button" Grid.Column="1"
                                Width="38" Height="20"
                                Background="{DynamicResource Surface2Brush}"
                                BorderBrush="{DynamicResource ButtonBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="1,0">
                            <Border.Transitions>
                                <Transitions>
                                    <BrushTransition Property="Background" Duration="0:0:0.18" />
                                    <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
                                </Transitions>
                            </Border.Transitions>
                            <Border x:Name="Mark" Width="16" Height="16" CornerRadius="8"
                                    Background="{DynamicResource SubTextBrush}"
                                    VerticalAlignment="Center" HorizontalAlignment="Left">
                                <Border.RenderTransform>
                                    <TranslateTransform X="0" />
                                </Border.RenderTransform>
                                <Border.Transitions>
                                    <Transitions>
                                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
                                        <BrushTransition Property="Background" Duration="0:0:0.18" />
                                    </Transitions>
                                </Border.Transitions>
                                <Path x:Name="CheckMark"
                                      Width="10" Height="10"
                                      Stretch="Uniform"
                                      Data="M 1.5,5.5 L 4,8 L 8.5,2.5"
                                      Stroke="{DynamicResource ThemeBrush}"
                                      StrokeThickness="1.8"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      IsVisible="False" />
                            </Border>
                        </Border>

                        <Grid x:Name="TextContainer" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <Grid.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="OnText"
                                             Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="OffText"
                                             Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                                </MultiBinding>
                            </Grid.IsVisible>
                            <TextBlock x:Name="OnText" FontSize="12" Foreground="{DynamicResource SubTextBrush}"
                                       VerticalAlignment="Center" Text="{TemplateBinding OnText}" />
                            <TextBlock x:Name="OffText" FontSize="12" Foreground="{DynamicResource SubTextBrush}"
                                       VerticalAlignment="Center" Text="{TemplateBinding OffText}" />
                        </Grid>

                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>