<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:ShiJian.Client.Controls.SettingPanel">


    <ControlTheme x:Key="{x:Type controls:SettingPanel}" TargetType="controls:SettingPanel">
        <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="SpliteLineBrush" Value="{DynamicResource DividerSubtleBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border CornerRadius="{StaticResource RadiusLarge}" x:Name="Border">
                    <StackPanel x:Name="Container" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
