<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:ShiJian.Client.Controls.Base">


    <ControlTheme x:Key="{x:Type controls:Placeholder}" TargetType="controls:Placeholder">
        <Setter Property="Template">
            <ControlTemplate>
                <Border CornerRadius="{TemplateBinding CornerRadius}"
                        ClipToBounds="True"
                        Background="{DynamicResource PlaceholderRectBgBrush}">
                    <Border x:Name="Flash" Background="{DynamicResource PlaceholderRectBgFlashBrush}" Width="28"
                            Height="{TemplateBinding Height}" Opacity=".35" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <TranslateTransform X="-10" />
                                <RotateTransform Angle="15" />
                            </TransformGroup>
                        </Border.RenderTransform>
                    </Border>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>