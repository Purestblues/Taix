<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cat="using:ShiJian.Client.Controls.Category">

    <!-- N14 UI Kit: Nord Flat Bordered Hierarchy & Tabular Typography -->

    <!-- 标准扁平卡片 (.card) -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        <Setter Property="BoxShadow" Value="{DynamicResource ElevationCard}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.09" />
                <BrushTransition Property="Background" Duration="0:0:0.09" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.card:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderHoverBrush}" />
    </Style>

    <!-- 指标统计卡 (.statCard) —— 全站概览/统计/分类汇总统一骨架 -->
    <Style Selector="Border.statCard">
        <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        <Setter Property="BoxShadow" Value="{DynamicResource ElevationCard}" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.09" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.statCard:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderHoverBrush}" />
    </Style>

    <!-- 交互浮层/可点击卡 (.cardElevated) -->
    <Style Selector="Border.cardElevated">
        <Setter Property="Background" Value="{DynamicResource Surface4Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}" />
        <Setter Property="BoxShadow" Value="{DynamicResource Elevation2}" />
    </Style>

    <!-- 扁平列表行 (.listRow) -->
    <Style Selector="Border.listRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.09" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.listRow:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
    </Style>
    <Style Selector="Border.listRow.selected">
        <Setter Property="Background" Value="{DynamicResource SelectionPillBrush}" />
    </Style>

    <!-- 排印阶梯与等宽数字 -->
    <Style Selector="TextBlock.pageTitle">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource DefaultTextBrush}" />
    </Style>

    <Style Selector="TextBlock.sectionHeader">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource DefaultTextBrush}" />
    </Style>

    <Style Selector="TextBlock.sectionTitle">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
    </Style>

    <Style Selector="TextBlock.cardTitle">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource DefaultTextBrush}" />
    </Style>

    <Style Selector="TextBlock.eyebrow">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
    </Style>

    <Style Selector="TextBlock.cardCaption, TextBlock.caption, TextBlock.muted">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
    </Style>

    <Style Selector="TextBlock.statValue">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFeatures" Value="tnum" />
        <Setter Property="Foreground" Value="{DynamicResource DefaultTextBrush}" />
    </Style>

    <Style Selector="TextBlock.num">
        <Setter Property="FontFeatures" Value="tnum" />
    </Style>

    <!-- 分类页列表卡片交互 -->
    <Style Selector="ListBox.categoryList.card cat|CategoryCard">
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
    </Style>
    <Style Selector="ListBoxItem:pointerover cat|CategoryCard">
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderHoverBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected cat|CategoryCard">
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush}" />
    </Style>
</Styles>
