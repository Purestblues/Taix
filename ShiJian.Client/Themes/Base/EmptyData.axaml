<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:ShiJian.Client.Controls.Base">

    <!-- 统一占位：加载中显示骨架条，其余显示插画 + 文案。
         颜色全部走主题资源，暗色 / 蔚蓝主题下不会再出现写死的浅灰块。 -->
    <ControlTheme x:Key="{x:Type controls:EmptyData}" TargetType="controls:EmptyData">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Styles>
            <Style Selector="controls|EmptyData[IsLoading=True] /template/ StackPanel#Skeleton">
                <Setter Property="IsVisible" Value="True" />
            </Style>
            <Style Selector="controls|EmptyData[IsLoading=True] /template/ StackPanel#Empty">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="controls|EmptyData[IsCompact=True] /template/ Border#Illustration">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </Styles>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Margin="10,16">
                    <!-- 加载中：三条骨架 -->
                    <StackPanel x:Name="Skeleton" Spacing="9" Width="180" IsVisible="False"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Height="10" Width="180" CornerRadius="{StaticResource RadiusXs}"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource Surface3Brush}" Opacity="0.9" />
                        <Border Height="10" Width="140" CornerRadius="{StaticResource RadiusXs}"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource Surface3Brush}" Opacity="0.7" />
                        <Border Height="10" Width="110" CornerRadius="{StaticResource RadiusXs}"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource Surface3Brush}" Opacity="0.5" />
                    </StackPanel>

                    <!-- 空态：卡片插画 + 文案 -->
                    <StackPanel x:Name="Empty" Spacing="8"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border x:Name="Illustration" Width="84" Height="84" CornerRadius="{StaticResource RadiusMedium}"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource Surface2Brush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1">
                            <Border.RenderTransform>
                                <RotateTransform Angle="4" />
                            </Border.RenderTransform>
                            <StackPanel Margin="12,14" Spacing="6">
                                <Border Height="10" CornerRadius="{StaticResource RadiusXs}"
                                        Background="{DynamicResource DividerStrongBrush}" Opacity="0.7" />
                                <Border Height="22" CornerRadius="{StaticResource RadiusXs}"
                                        Background="{DynamicResource Surface3Brush}" Opacity="0.9" />
                                <Border Height="10" Width="36" CornerRadius="{StaticResource RadiusXs}"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource DividerStrongBrush}" Opacity="0.5" />
                            </StackPanel>
                        </Border>

                        <TextBlock FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource SubTextBrush}"
                                   Text="{TemplateBinding Text}"
                                   IsVisible="{TemplateBinding Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource SubTextBrush}"
                                   Text="{DynamicResource NoData}"
                                   IsVisible="{TemplateBinding Text, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                        <TextBlock FontSize="10" HorizontalAlignment="Center" TextWrapping="Wrap"
                                   MaxWidth="220" TextAlignment="Center" Opacity="0.85"
                                   Foreground="{DynamicResource SubTextBrush}"
                                   Text="{TemplateBinding Description}"
                                   IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
