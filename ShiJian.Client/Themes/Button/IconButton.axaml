<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:ShiJian.Client.Controls.Button"
                    xmlns:base="using:ShiJian.Client.Controls.Base">

    <ControlTheme x:Key="{x:Type controls:IconButton}"
                  TargetType="controls:IconButton">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        <Setter Property="Cursor" Value="Hand" />
        <Styles>
            <Style Selector="controls|IconButton /template/ Border#BoxBorder">
                <Setter Property="Transitions">
                    <Transitions>
                        <BrushTransition Property="Background" Duration="0:0:0.09" />
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="controls|IconButton:pointerover /template/ Border#BoxBorder">
                <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
            </Style>
            <Style Selector="controls|IconButton:pointerover">
                <Setter Property="Foreground" Value="{DynamicResource DefaultTextBrush}" />
            </Style>
            <Style Selector="controls|IconButton:pressed /template/ Border#BoxBorder">
                <Setter Property="Background" Value="{DynamicResource PressedBackgroundBrush}" />
            </Style>
            <Style Selector="controls|IconButton /template/ Path#PathIcon">
                <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
            </Style>

            <!-- 窗口关闭按钮语义类：悬停实色危险红 + 纯白图标 -->
            <Style Selector="controls|IconButton.window-close:pointerover /template/ Border#BoxBorder">
                <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
            </Style>
            <Style Selector="controls|IconButton.window-close:pointerover">
                <Setter Property="Foreground" Value="White" />
            </Style>
        </Styles>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        x:Name="BoxBorder"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="4"
                        Background="Transparent">
                    <Grid>
                        <base:Icon x:Name="Icon"
                                   IconType="{TemplateBinding Icon}"
                                   Foreground="{TemplateBinding Foreground}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   FontSize="{TemplateBinding FontSize}"
                                   IsVisible="{TemplateBinding PathData, Converter={x:Static ObjectConverters.IsNull}}" />
                        <Path x:Name="PathIcon"
                              Data="{TemplateBinding PathData}"
                              StrokeThickness="{TemplateBinding PathStrokeThickness}"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"
                              Stretch="None"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"
                              IsVisible="{TemplateBinding PathData, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <ContentPresenter Content="{TemplateBinding Content}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
