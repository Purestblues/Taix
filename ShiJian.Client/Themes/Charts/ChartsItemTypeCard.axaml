<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:base="clr-namespace:ShiJian.Client.Controls.Base"
                    xmlns:converter="using:ShiJian.Client.Controls.Converters"
                    xmlns:controls="using:ShiJian.Client.Controls.Charts">

    <ControlTheme x:Key="{x:Type controls:ChartsItemTypeCard}" TargetType="controls:ChartsItemTypeCard">
        <ControlTheme.Resources>
            <converter:HextoColorConverter x:Key="HextoColorConverter" />
        </ControlTheme.Resources>
        <Setter Property="Width" Value="228" />
        <Setter Property="Height" Value="64" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        <Setter Property="Cursor" Value="Hand" />

        <Style Selector="^">
            <Style Selector="^ /template/ Border#CardSurface">
                <Setter Property="Transitions">
                    <Transitions>
                        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                        <BrushTransition Property="Background" Duration="0:0:0.15" />
                    </Transitions>
                </Setter>
            </Style>

            <Style Selector="^:pointerover /template/ Border#CardSurface">
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderHoverBrush}" />
                <Setter Property="Background" Value="{DynamicResource Surface3Brush}" />
            </Style>

            <Style Selector="^[IsLoading=True]">
                <Style Selector="^ /template/ base|Placeholder#Loading">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
                <Style Selector="^ /template/ Border#Normal">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
            </Style>
        </Style>

        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border x:Name="Normal"
                            ToolTip.Tip="{Binding Data.PopupText, RelativeSource={RelativeSource AncestorType={x:Type controls:ChartsItemTypeCard}}}">
                        <Border x:Name="CardSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="10,8">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <!-- 应用图标 -->
                                <Border Grid.Column="0"
                                        Width="36"
                                        Height="36"
                                        CornerRadius="{StaticResource RadiusSmall}"
                                        Background="{DynamicResource Surface3Brush}"
                                        VerticalAlignment="Center">
                                    <base:Img x:Name="IconObj"
                                              Radius="6"
                                              Width="24"
                                              Height="24"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              FallbackText="{Binding Data.FallbackText, RelativeSource={RelativeSource AncestorType={x:Type controls:ChartsItemTypeCard}}}"
                                              URL="{Binding Data.Icon, RelativeSource={RelativeSource AncestorType={x:Type controls:ChartsItemTypeCard}}}" />
                                </Border>

                                <!-- 应用名 + 分类标签 -->
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="3">
                                    <TextBlock x:Name="NameTextObj"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               MaxLines="1"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource DefaultTextBrush}"
                                               Text="{Binding Data.Name, RelativeSource={RelativeSource AncestorType={x:Type controls:ChartsItemTypeCard}}}" />

                                    <StackPanel Orientation="Horizontal"
                                                Spacing="4"
                                                IsVisible="{Binding Data.CategoryName,
                                                    RelativeSource={RelativeSource AncestorType={x:Type controls:ChartsItemTypeCard}},
                                                    Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <Border Width="6"
                                                Height="6"
                                                CornerRadius="3"
                                                VerticalAlignment="Center"
                                                Background="{Binding Data.CategoryColor,
                                                    RelativeSource={RelativeSource AncestorType={x:Type controls:ChartsItemTypeCard}},
                                                    Converter={StaticResource HextoColorConverter}}" />
                                        <TextBlock Text="{Binding Data.CategoryName, RelativeSource={RelativeSource AncestorType={x:Type controls:ChartsItemTypeCard}}}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource SubTextBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- 右侧时长胶囊 -->
                                <Border Grid.Column="2"
                                        VerticalAlignment="Center"
                                        CornerRadius="{StaticResource RadiusSmall}"
                                        Padding="7,3"
                                        Background="{DynamicResource Surface3Brush}">
                                    <TextBlock x:Name="ValueTextObj"
                                               FontFeatures="tnum"
                                               Foreground="{DynamicResource SubTextBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Border>
                    </Border>

                    <base:Placeholder x:Name="Loading"
                                      IsVisible="False"
                                      CornerRadius="{StaticResource RadiusMedium}"
                                      Width="228"
                                      Height="64" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
