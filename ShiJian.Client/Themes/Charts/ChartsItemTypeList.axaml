<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="using:ShiJian.Client.Controls.Charts.Model"
                    xmlns:base="using:ShiJian.Client.Controls.Base"
                    xmlns:model="using:ShiJian.Client.Controls.Charts.Model"
                    xmlns:converter="using:ShiJian.Client.Controls.Converters"
                    xmlns:controls="using:ShiJian.Client.Controls.Charts">


    <ControlTheme x:Key="{x:Type controls:ChartsItemTypeList}" TargetType="controls:ChartsItemTypeList">
        <ControlTheme.Resources>
            <converter:HextoColorConverter x:Key="HextoColorConverter" />
        </ControlTheme.Resources>
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="BarBrush" Value="{DynamicResource ChartTypeListProgressBarBrush}" />
        <Styles>
            <Style Selector="controls|ChartsItemTypeList">
                <Style Selector="^[IsLoading=True]">
                    <Style Selector="^ /template/ Grid#Loading">
                        <Setter Property="IsVisible" Value="True" />
                    </Style>
                    <Style Selector="^ /template/ Grid#Normal">
                        <Setter Property="IsVisible" Value="False" />
                    </Style>
                </Style>

                <Style Selector="^[IsShowBadge=True]">
                    <Style Selector="^ /template/ ListBox#BadgeListView">
                        <Setter Property="IsVisible" Value="True" />
                    </Style>
                </Style>

                <Style Selector="^ /template/ TextBlock#NameTextObj">
                    <Setter Property="Transitions">
                        <Transitions>
                            <BrushTransition Property="Foreground" Duration="0.3" />
                        </Transitions>
                    </Setter>
                </Style>


                <Style Selector="^:pointerover /template/ TextBlock#NameTextObj">
                    <Setter Property="Foreground" Value="{DynamicResource ThemeColor}" />
                </Style>

                <Style Selector="^ /template/ Border#IconBorder">
                    <Setter Property="Transitions">
                        <Transitions>
                            <BrushTransition Property="BorderBrush" Duration="0.3" />
                            <BrushTransition Property="Background" Duration="0.3" />
                        </Transitions>
                    </Setter>
                </Style>

                <Style Selector="^:pointerover /template/ Border#IconBorder">
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeColor}" />
                    <Setter Property="Background" Value="{DynamicResource HoverBackgroundColor}" />
                </Style>
            </Style>
        </Styles>
        <Setter Property="Template">

            <ControlTemplate>
                <!-- 扁平行：底部 1px 发丝线，无圆角无阴影（相邻行由 BorderThickness 共享一条线） -->
                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                        Padding="6,7" Background="{TemplateBinding Background}">
                <Grid>
                    <Grid x:Name="Normal">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Margin="0,0,10,0" x:Name="IconBorder" BorderBrush="Transparent" BorderThickness="0"
                                Background="Transparent" CornerRadius="6" Width="26"
                                Height="26"
                                HorizontalAlignment="Left">
                            <base:Img x:Name="IconObj" Width="{TemplateBinding IconSize}"
                                             Height="{TemplateBinding IconSize}"
                                             DecodeWidth="{TemplateBinding IconSize}"
                                             URL="{Binding Data.Icon,RelativeSource={RelativeSource TemplatedParent}}"
                                             FallbackText="{Binding Data.FallbackText,RelativeSource={RelativeSource TemplatedParent}}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" x:Name="ValueContainer" VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="NameTextObj"
                                           Text="{Binding Data.Name,RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{DynamicResource DefaultTextBrush}"
                                           FontSize="13" FontWeight="Medium"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center" />

                                <ListBox x:Name="BadgeListView" IsVisible="False" Grid.Column="1"
                                         Cursor="Hand"
                                         ItemsSource="{Binding Data.BadgeList,RelativeSource={RelativeSource TemplatedParent}}"
                                         Margin="0,0,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                                    <ListBox.Styles>
                                        <Style Selector="ListBox">
                                            <Setter Property="Template">
                                                <ControlTemplate>
                                                    <Border>
                                                        <ItemsPresenter
                                                            ItemsPanel="{TemplateBinding ItemsPanel}" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter>
                                        </Style>

                                        <Style Selector="ListBoxItem">

                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="Template">
                                                <ControlTemplate>
                                                    <Border BorderBrush="Transparent"
                                                            BorderThickness="2" x:Name="Border"
                                                            x:DataType="model:ChartBadgeModel"
                                                            Background="{Binding Color,Converter={StaticResource HextoColorConverter}}"
                                                            Margin="5,0,0,0" Padding="6,4"
                                                            CornerRadius="6">
                                                        <ContentPresenter VerticalAlignment="Center"

                                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                          Content="{TemplateBinding Content}"
                                                                          HorizontalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter>
                                        </Style>
                                    </ListBox.Styles>


                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>

                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:ChartBadgeModel">

                                            <WrapPanel Orientation="Horizontal">
                                                <Border>
                                                    <TextBlock Text="{Binding Name}" FontSize="10"
                                                               Foreground="{Binding TextColor,Converter={StaticResource HextoColorConverter}}" />
                                                </Border>

                                            </WrapPanel>

                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                            <StackPanel Orientation="Horizontal">
                                <Rectangle
                                    x:Name="ValueBlockObj"
                                    RadiusX="1.5"
                                    RadiusY="1.5"
                                    Fill="{TemplateBinding BarBrush}"
                                    Height="3"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left">
                                    <Rectangle.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="Width" Duration="0:0:0.55" Easing="CubicEaseOut" />
                                        </Transitions>
                                    </Rectangle.Transitions>
                                </Rectangle>

                                <TextBlock x:Name="ValueTextObj" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SubTextBrush}" FontSize="12" Margin="5,0,0,0" />
                            </StackPanel>

                        </StackPanel>
                    </Grid>


                    <Grid x:Name="Loading" IsVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <base:Placeholder Margin="0,0,10,0" CornerRadius="6" Width="26" Height="26"
                                          HorizontalAlignment="Left" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Rectangle
                                RadiusX="0"
                                RadiusY="0"
                                Fill="{DynamicResource PlaceholderRectBgBrush}"
                                Height="3"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>
                </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>


</ResourceDictionary>