<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:base="using:ShiJian.Client.Controls.Base"
                    xmlns:controls="using:ShiJian.Client.Controls.Charts">

    <ControlTheme x:Key="{x:Type controls:ChartsItemTypeMonth}" TargetType="controls:ChartsItemTypeMonth">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="2" />
        <Style Selector="^">
            <Style Selector="^[IsLoading=True]">
                <Setter Property="Template">
                    <ControlTemplate>
                        <base:Placeholder CornerRadius="{StaticResource RadiusSmall}"
                                          Width="24" Height="24" />
                    </ControlTemplate>
                </Setter>
            </Style>
            <Style Selector="^[IsSelected=True] /template/ Border#Border">
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush}" />
                <Setter Property="BorderThickness" Value="1.5" />
            </Style>
        </Style>
        <Setter Property="Template">
            <ControlTemplate>
                <Border ToolTip.Tip="{TemplateBinding ToolTip}"
                        x:Name="Border"
                        Width="24"
                        Height="24"
                        ClipToBounds="True"
                        CornerRadius="{StaticResource RadiusSmall}"
                        Background="{DynamicResource Surface3Brush}"
                        BorderBrush="Transparent"
                        BorderThickness="1">
                    <Rectangle x:Name="ValueBlockObj"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RadiusX="4"
                               RadiusY="4"
                               Opacity="0.86"
                               Fill="{DynamicResource ThemeBrush}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
