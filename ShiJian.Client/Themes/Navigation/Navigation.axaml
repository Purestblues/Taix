<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:ShiJian.Client.Controls.Navigation">

    <Design.PreviewWith>
        <Border Padding="20" Background="#ECEFF4">
            <controls:Navigation Width="176">
                <controls:Navigation.BottomExtContent>
                    <StackPanel Spacing="2">
                        <controls:NavigationItem Title="概览" Icon="Home" IsSelected="True" />
                        <controls:NavigationItem Title="图表" Icon="ZeroBars" />
                        <controls:NavigationItem Title="设置" Icon="Settings" />
                    </StackPanel>
                </controls:Navigation.BottomExtContent>
            </controls:Navigation>
        </Border>
    </Design.PreviewWith>

    <ControlTheme x:Key="{x:Type controls:Navigation}"
                  TargetType="controls:Navigation">

        <Setter Property="MinWidth" Value="56" />
        <Setter Property="Background" Value="{DynamicResource Surface1Brush}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="SidebarSurface"
                        Background="{TemplateBinding Background}"
                        Padding="8,8,8,12">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <!-- 顶部扩展区（侧栏头部 / 折叠按钮） -->
                        <ContentPresenter Grid.Row="0"
                                          Content="{TemplateBinding TopExtContent}" />

                        <!-- 主导航列表 -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <Grid Background="Transparent" x:Name="MenuGrid">
                                <StackPanel x:Name="ItemsPanel" Spacing="0" />
                            </Grid>
                        </ScrollViewer>

                        <!-- 底部固定区（全局搜索触发 + 设置） -->
                        <ContentPresenter Grid.Row="2"
                                          Content="{TemplateBinding BottomExtContent}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
