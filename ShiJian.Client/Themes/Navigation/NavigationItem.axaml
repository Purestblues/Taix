<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:base="clr-namespace:ShiJian.Client.Controls.Base"
                    xmlns:controls="using:ShiJian.Client.Controls.Navigation">

    <Design.PreviewWith>
        <Border Padding="20" Background="#E5E9F0" Width="176">
            <StackPanel Spacing="4">
                <controls:NavigationItem Title="概览" Icon="Home" SelectedIcon="HomeSolid" IsSelected="True" />
                <controls:NavigationItem Title="统计" Icon="ZeroBars" />
                <controls:NavigationItem Title="详细" Icon="BulletedList" />
                <controls:NavigationItem Title="折叠态" Icon="Folder" IsCompact="True" />
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <ControlTheme x:Key="{x:Type controls:NavigationItem}"
                  TargetType="controls:NavigationItem">
        <Setter Property="Height" Value="38" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ToolTip.Tip" Value="{Binding Title, RelativeSource={RelativeSource Self}}" />
        <Styles>
            <Style Selector="controls|NavigationItem /template/ Border#Border">
                <Setter Property="Transitions">
                    <Transitions>
                        <BrushTransition Property="Background" Duration="0:0:0.09" />
                        <BrushTransition Property="BorderBrush" Duration="0:0:0.09" />
                    </Transitions>
                </Setter>
            </Style>

            <Style Selector="controls|NavigationItem:pointerover">
                <Setter Property="Foreground" Value="{DynamicResource DefaultTextBrush}" />
            </Style>
            <Style Selector="controls|NavigationItem:pointerover /template/ Border#Border">
                <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
            </Style>

            <Style Selector="controls|NavigationItem:focus-visible /template/ Border#Border">
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush}" />
                <Setter Property="BorderThickness" Value="1.5" />
            </Style>

            <!-- 选中态：柔和胶囊底 + 品牌色字体与图标，无弹跳缩放、无彩色发光阴影 -->
            <Style Selector="controls|NavigationItem[IsSelected=True]">
                <Setter Property="Foreground" Value="{DynamicResource ThemeBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style Selector="controls|NavigationItem[IsSelected=True] /template/ Border#Border">
                <Setter Property="Background" Value="{DynamicResource SelectionPillBrush}" />
            </Style>
            <Style Selector="controls|NavigationItem[IsSelected=True] /template/ base|Icon#Icon">
                <Setter Property="IconType" Value="{Binding SelectedIcon, RelativeSource={RelativeSource TemplatedParent}}" />
            </Style>

            <!-- 折叠紧凑态（56px 侧栏）：隐藏文字、图标居中 -->
            <Style Selector="controls|NavigationItem[IsCompact=True]">
                <Setter Property="Padding" Value="0" />
            </Style>
            <Style Selector="controls|NavigationItem[IsCompact=True] /template/ TextBlock#TitleText">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="controls|NavigationItem[IsCompact=True] /template/ Grid#ContentGrid">
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
        </Styles>

        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="Border"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <Grid x:Name="ContentGrid"
                          ColumnDefinitions="Auto,*"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Stretch">
                        <base:Icon x:Name="Icon"
                                   Grid.Column="0"
                                   IconType="{TemplateBinding Icon}"
                                   FontSize="16"
                                   Foreground="{TemplateBinding Foreground}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="TitleText"
                                   Grid.Column="1"
                                   Margin="12,0,0,0"
                                   Text="{TemplateBinding Title}"
                                   FontSize="13"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   Foreground="{TemplateBinding Foreground}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
