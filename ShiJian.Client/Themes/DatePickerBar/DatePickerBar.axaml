<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:base="using:ShiJian.Client.Controls.Base"
                    xmlns:list="using:ShiJian.Client.Controls.List"
                    xmlns:controls="using:ShiJian.Client.Controls.DatePickerBar"
                    xmlns:behaviors="using:ShiJian.Client.Behaviors">

    <ControlTheme x:Key="{x:Type controls:DatePickerBar}" TargetType="controls:DatePickerBar">
        <Styles>
            <Style Selector="controls|DatePickerBar[ShowType=Year]">
                <Style Selector="^ /template/ Grid#ItemSelect">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
            </Style>

            <Style Selector="controls|DatePickerBar:pointerover  /template/ Border#Date">
                <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderHoverBrush}" />
            </Style>

            <Style Selector="controls|DatePickerBar[IsShowDatePickerPopup=True]  /template/ base|Icon#PopupIcon">
                <Setter Property="RenderTransform" Value="rotate(-180deg)" />
                <Setter Property="Foreground" Value="{DynamicResource ThemeBrush}" />
            </Style>
        </Styles>
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border>
                    <StackPanel>
                        <Grid x:Name="header">
                            <Border
                                x:Name="Date"
                                Background="{DynamicResource Surface3Brush}"
                                Padding="12,0"
                                Height="34"
                                CornerRadius="{StaticResource RadiusSmall}"
                                Margin="0,0,0,10"
                                HorizontalAlignment="Left"
                                Cursor="Hand"
                                ToolTip.Tip="{DynamicResource Select}"
                                BorderBrush="{DynamicResource ButtonBorderBrush}"
                                BorderThickness="1">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <base:Icon x:Name="DateIcon" Margin="0,0,6,0" IconType="Calendar" FontSize="13"
                                               Foreground="{DynamicResource SubTextBrush}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />

                                    <TextBlock Foreground="{DynamicResource DefaultTextBrush}"
                                               FontSize="13" FontWeight="Medium" FontFeatures="tnum"
                                               Text="{TemplateBinding SelectedDateString}"
                                               Margin="0,0" VerticalAlignment="Center"
                                               HorizontalAlignment="Left" />
                                    <base:Icon x:Name="PopupIcon" Width="18" Height="18"
                                               Margin="8,0,0,0" FontSize="10" IconType="ChevronDown"
                                               Foreground="{DynamicResource SubTextBrush}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <base:Icon.RenderTransform>
                                            <RotateTransform Angle="0" CenterX="9" CenterY="9" />
                                        </base:Icon.RenderTransform>

                                        <base:Icon.Transitions>
                                            <Transitions>
                                                <TransformOperationsTransition
                                                    Property="RenderTransform"
                                                    Duration="0:0:0.18" />

                                                <BrushTransition Property="Foreground" Duration="0:0:0.18" />
                                            </Transitions>
                                        </base:Icon.Transitions>
                                    </base:Icon>
                                </StackPanel>

                                <Border.Transitions>
                                    <Transitions>
                                        <BrushTransition Property="Background" Duration="0:0:0.15" />
                                        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                                    </Transitions>
                                </Border.Transitions>
                            </Border>

                            <Popup
                                x:Name="DatePickerPopup"
                                IsOpen="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsShowDatePickerPopup, Mode=TwoWay}"
                                Placement="Bottom"
                                PlacementTarget="{Binding ElementName=Date}">
                                <Interaction.Behaviors>
                                    <behaviors:PopupScrollDismissBehavior />
                                </Interaction.Behaviors>
                                <Border
                                    Background="{DynamicResource PopupBackgroundBrush}"
                                    BorderBrush="{DynamicResource PopupBorderBrush}"
                                    BorderThickness="1"
                                    BoxShadow="{DynamicResource Elevation2}"
                                    CornerRadius="{StaticResource RadiusMedium}"
                                    Padding="14"
                                    Margin="8">

                                    <StackPanel Spacing="12">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Year}" HorizontalAlignment="Center"
                                                       FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{DynamicResource SubTextBrush}"
                                                       Margin="0,0,0,8" />
                                            <UniformGrid x:Name="YearsGrid" Columns="4" Rows="2"
                                                         Width="200" Height="80" />
                                        </StackPanel>
                                        <StackPanel x:Name="MonthSelect" IsVisible="False">
                                            <TextBlock Text="{DynamicResource Month}" HorizontalAlignment="Center"
                                                       FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{DynamicResource SubTextBrush}"
                                                       Margin="0,0,0,8" />
                                            <UniformGrid x:Name="MonthsGrid" Columns="4" Rows="3"
                                                         Width="200" Height="120" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <Grid x:Name="ItemSelect">
                            <Border Background="{DynamicResource Surface2Brush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    Padding="6" CornerRadius="{StaticResource RadiusMedium}" Margin="0,6,0,0">
                                <ScrollViewer x:Name="ScrollViewer" VerticalScrollBarVisibility="Disabled"
                                              HorizontalScrollBarVisibility="Hidden">
                                    <StackPanel
                                        Orientation="Horizontal"
                                        x:Name="Container" />
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>