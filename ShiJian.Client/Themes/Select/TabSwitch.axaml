<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:ShiJian.Client.Controls.Select">

    <ControlTheme x:Key="{x:Type controls:TabSwitch}" TargetType="controls:TabSwitch">
        <Styles>
            <Style Selector="controls|TabSwitch:focus-visible /template/ Border#RootBorder">
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush}" />
                <Setter Property="BorderThickness" Value="2" />
            </Style>
        </Styles>
        <Setter Property="Background" Value="{DynamicResource Surface3Brush}" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="RootBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Padding="{TemplateBinding Padding}">
                    <Grid>
                        <Border x:Name="Slider"
                                Background="{DynamicResource Surface2Brush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                BoxShadow="{DynamicResource ElevationCard}"
                                CornerRadius="{StaticResource RadiusSmall}"
                                Width="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                IsHitTestVisible="False"
                                IsVisible="False">
                            <Border.Transitions>
                                <Transitions>
                                    <ThicknessTransition Property="Margin"
                                                         Duration="0:0:0.20">
                                        <ThicknessTransition.Easing>
                                            <CubicEaseInOut />
                                        </ThicknessTransition.Easing>
                                    </ThicknessTransition>
                                    <DoubleTransition Property="Width"
                                                      Duration="0:0:0.20">
                                        <DoubleTransition.Easing>
                                            <CubicEaseInOut />
                                        </DoubleTransition.Easing>
                                    </DoubleTransition>
                                </Transitions>
                            </Border.Transitions>
                        </Border>

                        <StackPanel x:Name="ItemsContainer"
                                    Orientation="Horizontal"
                                    Spacing="1" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>