<c:TPage xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:behaviors="using:ShiJian.Client.Behaviors"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
         xmlns:list="using:ShiJian.Client.Controls.List"
         xmlns:Button="using:ShiJian.Client.Controls.Button"
         xmlns:input="using:ShiJian.Client.Controls.Input"
         xmlns:select="using:ShiJian.Client.Controls.Select"
         xmlns:base="using:ShiJian.Client.Controls.Base"
             xmlns:cat="using:ShiJian.Client.Controls.Category"
         xmlns:toggle="using:ShiJian.Client.Controls.Toggle"
         xmlns:vm="using:ShiJian.Client.ViewModels"
         xmlns:c="using:ShiJian.Client.Controls"
         x:DataType="vm:CategoryPageViewModel"
         IsFillPage="True"
         x:Class="ShiJian.Client.Views.CategoryPage">

    <Grid>
        <Grid
            ZIndex="2"
            Margin="0"
            IsVisible="{Binding EditVisibility}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
            <Border Background="Black" Opacity=".7" CornerRadius="{StaticResource RadiusSmall}" />
            <Border Width="{Binding ElementName=EditBorder,Path=Bounds.Width}"
                    Height="{Binding ElementName=EditBorder,Path=Bounds.Height}"
                    Background="{Binding ElementName=EditBorder,Path=Background}"
                    CornerRadius="{Binding ElementName=EditBorder,Path=CornerRadius}">
                <Border.Effect>
                    <DropShadowDirectionEffect BlurRadius="30" Direction="0"
                                               ShadowDepth="0"
                                               Opacity=".2"
                                               Color="{DynamicResource ThemeColor}" />
                </Border.Effect>
            </Border>

            <Border x:Name="EditBorder" MaxWidth="400" MaxHeight="350"
                    Background="{DynamicResource StandardBackgroundBrush2}"
                    CornerRadius="{StaticResource RadiusMedium}"
                    BorderBrush="{DynamicResource WindowContentBorder}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="80" />

                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                            <base:Text Content="{DynamicResource ExCreateEdit}" Value="{Binding IsCreate}"
                                       VerticalAlignment="Center" />
                            <TextBlock VerticalAlignment="Center">
                                <Run Text="{Binding ShowType.Name}" />
                                <Run Text="{DynamicResource SideSort}" />
                            </TextBlock>
                        </StackPanel>
                        <Button:IconButton Foreground="{DynamicResource SubTextBrush}"
                                           Icon="ChromeClose"
                                           HorizontalAlignment="Right"
                                           FontSize="12" Margin="0,0,10,0"
                                           Command="{Binding EditCloseCommand}" />
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Hidden" Grid.Row="1" x:Name="viewer">
                        <StackPanel Margin="10">
                            <TextBlock Text="{DynamicResource ClassificationName}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <base:ColorSelect Color="{Binding EditColor,Mode=TwoWay}"
                                                  ToolTip.Tip="{DynamicResource SelectCategoryColors}"
                                                  HorizontalAlignment="Left"
                                                  Margin="0,10,0,0" />

                                <input:InputBox Grid.Column="1" Error="{Binding EditErrorText}"
                                                IsShowError="{Binding IsEditError,Mode=TwoWay}"
                                                Text="{Binding EditName,Mode=TwoWay}"
                                                MaxLength="10" Margin="5,10,0,0"
                                                Placeholder="{DynamicResource PleaseEnterCategoryName}" />
                            </Grid>
                            <TextBlock Text="{DynamicResource Icon}" Margin="0,10,0,0" />
                            <base:IconSelect URL="{Binding EditIconFile,Mode=TwoWay}"
                                             HorizontalAlignment="Left"
                                             Margin="0,10,0,0" />
                            <base:View Condition="=0" Value="{Binding ShowType.Id}">
                                <StackPanel IsVisible="{Binding !IsSysCategory}">
                                    <Border Margin="0,10,0,0">
                                        <toggle:Toggle
                                            IsChecked="{Binding EditIsDirectoryMatch,Mode=TwoWay}" TextPosition="Left"
                                            OnText="{DynamicResource DirectoryMatch}"
                                            OffText="{DynamicResource DirectoryMatch}" />
                                    </Border>
                                    <base:View Condition="True" Value="{Binding EditIsDirectoryMatch}">
                                        <StackPanel Margin="0,10,0,0">
                                            <Button:Button HorizontalAlignment="Right" Width="100"
                                                           Command="{Binding AddDirectoryCommand}"
                                                           Content="{DynamicResource AddDirectory}" />
                                            <list:BaseList Items="{Binding EditDirectories,Mode=OneWay}"
                                                           SelectedItem="{Binding EditSelectedDirectory,Mode=TwoWay}">
                                                <list:BaseList.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="{DynamicResource Remove}"
                                                                  Command="{Binding DirectoriesCommand}"
                                                                  CommandParameter="remove" />
                                                    </ContextMenu>
                                                </list:BaseList.ContextMenu>
                                            </list:BaseList>
                                        </StackPanel>
                                    </base:View>
                                </StackPanel>
                            </base:View>
                            <!-- URL 匹配 (网页分类) -->
                            <base:View Condition="=1" Value="{Binding ShowType.Id}">
                              <StackPanel IsVisible="{Binding !IsSysCategory}">
                                <Border Margin="0,10,0,0">
                                  <toggle:Toggle
                                    IsChecked="{Binding EditIsUrlMatch,Mode=TwoWay}" TextPosition="Left"
                                    OnText="{DynamicResource UrlMatch}"
                                    OffText="{DynamicResource UrlMatch}" />
                                </Border>

                                <base:View Condition="True" Value="{Binding EditIsUrlMatch}">
                                  <StackPanel Margin="0,10,0,0">
                                    <Button:Button HorizontalAlignment="Right" Width="100"
                                                   Command="{Binding AddUrlPatternCommand}"
                                                   Content="{DynamicResource AddUrlPattern}" />
                                    <list:BaseList Items="{Binding EditUrlPatterns,Mode=OneWay}"
                                                   SelectedItem="{Binding EditSelectedUrlPattern,Mode=TwoWay}">
                                      <list:BaseList.ContextMenu>
                                        <ContextMenu>
                                          <MenuItem Header="{DynamicResource Remove}"
                                                    Command="{Binding UrlPatternsCommand}"
                                                    CommandParameter="remove" />
                                        </ContextMenu>
                                      </list:BaseList.ContextMenu>
                                    </list:BaseList>
                                  </StackPanel>
                                </base:View>
                              </StackPanel>
                            </base:View>
                        </StackPanel>
                    </ScrollViewer>

                    <Button:Button Grid.Row="2" HorizontalAlignment="Right" Text="{DynamicResource ExCreateUpdate}"
                                   Value="{Binding IsCreate}" Width="120" Margin="0,0,10,0" VerticalAlignment="Center"
                                   Command="{Binding EditDoneCommand}" />
                </Grid>
            </Border>
        </Grid>

        <Grid Margin="24" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{DynamicResource Refresh}" Command="{Binding RefreshCommand}" />
                </ContextMenu>
            </Grid.ContextMenu>

            <Grid Margin="0,8,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource SideSort}" FontSize="18" VerticalAlignment="Center" />
                    <select:TabSwitch Margin="10,0,0,0" VerticalAlignment="Center"
                                   IsShowIcon="False" SelectedItem="{Binding ShowType,Mode=TwoWay}"
                                   Options="{Binding ShowTypeOptions}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <select:TabSwitch Margin="0,0,10,0" VerticalAlignment="Center"
                                   IsShowIcon="False" SelectedItem="{Binding ViewMode,Mode=TwoWay}"
                                   Options="{Binding ViewModeOptions}" />
                    <Button:Button Icon="CalculatorAddition"
                               Content="{DynamicResource NewCategory}"
                               Width="150"
                               Command="{Binding EditCommand}" />
                </StackPanel>
            </Grid>

            <TabControl
                SelectedIndex="{Binding ShowType.Id}"
                BorderThickness="0"
                Margin="0,10,0,0"
                Padding="0"
                Background="Transparent"
                Grid.Row="1">
                <TabControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid />
                    </ItemsPanelTemplate>
                </TabControl.ItemsPanel>
                <TabControl.Styles>
                    <Style Selector="TabItem">
                        <Setter Property="Template">
                            <ControlTemplate />
                        </Setter>
                    </Style>
                </TabControl.Styles>

                <TabItem>
                    <Grid>
                        <base:View Condition="empty" Value="{Binding Data}">
                            <base:EmptyData IsLoading="{Binding IsLoading}" />
                        </base:View>

                        <ListBox Margin="10,20,10,0" ItemsSource="{Binding Data}"
                                 Classes="categoryList" Classes.card="{Binding IsCardView}"
                                 SelectedItem="{Binding SelectedAppCategoryItem,Mode=TwoWay}"
                                 PointerPressed="OnAppCategoryListBoxPointerPressed"
                                 behaviors:KeyboardListActivation.EnterCommand="{Binding GotoListCommand}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <Interaction.Behaviors>
                                <EventTriggerBehavior EventName="PointerReleased">
                                    <InvokeCommandAction Command="{Binding GotoListCommand}"
                                                         CommandParameter="{Binding SelectedAppCategoryItem}" />

                                </EventTriggerBehavior>


                            </Interaction.Behaviors>

                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{DynamicResource ViewCategoryAppList}"
                                              Command="{Binding GotoListCommand}"
                                              CommandParameter="{Binding SelectedAppCategoryItem}" />
                                    <MenuItem Header="{DynamicResource Edit}" Command="{Binding EditCommand}"
                                              CommandParameter="{Binding SelectedAppCategoryItem}" />
                                    <MenuItem Header="{DynamicResource DeleteCategory}" Command="{Binding DelCommand}"
                                              IsVisible="{Binding !SelectedAppCategoryItem.Data.IsSystem}"
                                              CommandParameter="{Binding SelectedAppCategoryItem}" />

                                    <MenuItem Header="{DynamicResource ReApplyDirectoryMatch}"
                                              Command="{Binding ApplyDirectoryMatchCommand}"
                                              IsVisible="{Binding SelectedAppCategoryItem.Data.IsDirectoryMatch, FallbackValue=False}" />
                                    <MenuItem Header="{DynamicResource RestoreSystemCategory}"
                                              Command="{Binding RestoreSystemCategoryCommand}"
                                              IsVisible="{Binding SelectedAppCategoryItem.Data.IsSystem}"
                                              CommandParameter="{Binding SelectedAppCategoryItem}" />
                                </ContextMenu>
                            </ListBox.ContextMenu>

                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template">
                                        <ControlTemplate>
                                            <ContentPresenter Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                                        </ControlTemplate>
                                    </Setter>
                                </Style>

                                <Style Selector="ListBox">
                                    <Setter Property="Template">
                                        <ControlTemplate>
                                            <ScrollViewer>
                                                <Border>
                                                    <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
                                                </Border>
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </Setter>
                                </Style>
                            </ListBox.Styles>

                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <cat:CategoryCard />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>


                <ScrollViewer>
                    <StackPanel>
                        <base:View Condition="empty" Value="{Binding WebCategoryData}">
                            <base:EmptyData IsLoading="{Binding IsLoading}" />
                        </base:View>

                        <ListBox Margin="10,20,10,0"
                                 Classes="categoryList" Classes.card="{Binding IsCardView}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectedItem="{Binding SelectedWebCategoryItem,Mode=TwoWay}"
                                 PointerPressed="OnWebCategoryListBoxPointerPressed"
                                 behaviors:KeyboardListActivation.EnterCommand="{Binding GotoListCommand}"
                                 ItemsSource="{Binding WebCategoryData}">

                            <Interaction.Behaviors>
                                <EventTriggerBehavior EventName="PointerReleased">
                                    <InvokeCommandAction Command="{Binding GotoListCommand}"
                                                         CommandParameter="{Binding SelectedWebCategoryItem}" />
                                </EventTriggerBehavior>
                            </Interaction.Behaviors>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{DynamicResource ViewWebsiteList}"
                                              Command="{Binding GotoListCommand}"
                                              CommandParameter="{Binding SelectedWebCategoryItem}" />
                                    <MenuItem Header="{DynamicResource Edit}" Command="{Binding EditCommand}"
                                              CommandParameter="{Binding SelectedWebCategoryItem}" />
                                    <MenuItem Header="{DynamicResource ReApplyUrlMatch}"
                                              Command="{Binding ApplyUrlMatchCommand}"
                                              IsVisible="{Binding SelectedWebCategoryItem.Data.IsUrlMatch, FallbackValue=False}" />
                                    <MenuItem Header="{DynamicResource DeleteCategory}" Command="{Binding DelCommand}"
                                              IsVisible="{Binding !SelectedWebCategoryItem.Data.IsSystem}"
                                              CommandParameter="{Binding SelectedWebCategoryItem}" />
                                </ContextMenu>
                            </ListBox.ContextMenu>

                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template">
                                        <ControlTemplate>
                                            <ContentPresenter Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                                        </ControlTemplate>
                                    </Setter>
                                </Style>

                                <Style Selector="ListBox">
                                    <Setter Property="Template">
                                        <ControlTemplate>
                                            <ScrollViewer>
                                                <Border>
                                                    <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
                                                </Border>
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </Setter>
                                </Style>
                            </ListBox.Styles>

                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <cat:CategoryCard />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </TabControl>
        </Grid>
    </Grid>
</c:TPage>
