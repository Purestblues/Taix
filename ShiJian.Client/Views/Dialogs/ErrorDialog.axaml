<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" Height="340"
        Width="420" CanResize="False"
        WindowStartupLocation="CenterScreen"
        x:Class="ShiJian.Client.Views.Dialogs.ErrorDialog"
        Title="ErrorDialog">
    <Grid Margin="16">
        <StackPanel>
            <Image x:Name="IconGray" Width="120"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Source="/Resources/Icons/ghost_gray (320).ico">
                <Image.RenderTransform>
                    <TranslateTransform Y="0" />
                </Image.RenderTransform>
            </Image>
            <Border Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLarge}" Padding="16" Margin="0,-46,0,16"
                    BoxShadow="{DynamicResource Elevation3}">

                <StackPanel x:Name="Content">
                    <TextBlock Foreground="{DynamicResource SubTextBrush}" Text="{DynamicResource UnexpectedError}" FontSize="14"
                               FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,0" />
                    <TextBlock Foreground="{DynamicResource SubTextBrush}" TextWrapping="WrapWithOverflow" FontSize="14"
                               HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Run Text="{DynamicResource SincerelyCrash}" />
                        <HyperlinkButton ToolTip.Tip="{DynamicResource LocateFileExplorer}" Click="LogHyperlinkClick"
                                         Foreground="{DynamicResource ThemeBrush}" Content="{DynamicResource Log}" />
                        <Run Text="{DynamicResource PleaseSubmit}" />
                    </TextBlock>
                    <TextBlock Foreground="{DynamicResource SubTextBrush}" Text="{DynamicResource HowSubmitLog}" FontSize="14" FontWeight="Bold"
                               HorizontalAlignment="Left" Margin="0,10,0,0" />

                    <TextBlock Foreground="{DynamicResource SubTextBrush}" TextWrapping="WrapWithOverflow" FontSize="14"
                               HorizontalAlignment="Left" Margin="0,5,0,0">
                        <Run Text="{DynamicResource ViaThe}" />
                        <HyperlinkButton Foreground="{DynamicResource ThemeBrush}" ToolTip.Tip="{DynamicResource OpenInBrowser}"
                                         Click="IssuesHyperlinkClick">
                            Github Issues
                        </HyperlinkButton>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
